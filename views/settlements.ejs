<%- include('partials/open', { title: 'Settlements', user: user, active: 'settlements' }) %>
<h1>Settlements</h1>
<% if (saved === 'week') { %><div class="all-clear">Weekly driver settlement finalized. Those loads are now Settled and locked, and the driver can see that week's pay.</div><% } %>
<% if (user.role === 'admin') { %>
  <p class="muted">Loads Approved for Settlement are grouped by driver and Monday–Sunday work week (by Load Date). Review each week, download the PDF, then Finalize it for payroll. A finalized week is locked: its loads can no longer be edited, rejected, or deleted, and the driver sees that week's pay. Customer billing is on <a href="/invoices">Invoices</a>.</p>
  <p class="muted">On percentage loads, driver pay is the driver's profile pay percentage of Qty × Rate and of the drive-time fee. Flat/daily-rate loads include the full drive-time fee. Self load and detention are added in full. Fuel surcharge is never included in driver pay.</p>
  <h2>Ready to Finalize</h2>
  <% if (pendingWeeks && pendingWeeks.length) { %>
    <% pendingWeeks.forEach(function (group) { %>
      <% const range = group.week && group.week.range && group.week.start ? group.week.range : ''; %>
      <div class="card settlement-card settlement-pending">
        <h3><%= range ? 'Driver Settlement - Week of ' + range : 'Driver Settlement - Undated' %></h3>
        <div><strong><%= group.driver %></strong><% if (group.percentage != null) { %> · Pay <%= group.percentage %><% } %></div>
        <div class="settlement-meta">
          <%= group.loads.length %> load<%= group.loads.length === 1 ? '' : 's' %>
          · Qty/Wet Ton <%= group.qty %>
          · Not finalized
        </div>
        <div class="settlement-amounts">
          <div class="pay-line admin-driver-pay">Driver Pay <%= usd(group.total) %></div>
          <div class="total-load-pay-line">Total Load Pay (invoiced) <%= usd(group.totalLoadPay) %></div>
        </div>
        <div class="muted">Base <%= usd(group.base) %> · Drive Time <%= usd(group.drive) %> · Self Load <%= usd(group.self) %> · Detention <%= usd(group.detention) %></div>
        <%- include('partials/settlement-loads', { loads: group.loads, user: user }) %>
        <% if (group.driverId && group.week.start) { %>
          <div class="settlement-actions">
            <a class="btn btn-secondary" href="/settlements/pdf?kind=pending&amp;driver_id=<%= group.driverId %>&amp;week_start=<%= group.week.start %>">Download PDF (draft)</a>
            <form method="POST" action="/settlements/approve-week" onsubmit="return confirm('Finalize <%= String(group.driver).replace(/[\\'\r\n]/g, '') %>\'s settlement for the week of <%= range %>?\n\nFinalized settlements are locked: these loads can no longer be edited, rejected, or deleted, and the driver will see this week\'s pay.');">
              <input type="hidden" name="driver_id" value="<%= group.driverId %>">
              <input type="hidden" name="week_start" value="<%= group.week.start %>">
              <button type="submit">Finalize Weekly Settlement</button>
            </form>
          </div>
        <% } %>
      </div>
    <% }) %>
  <% } else { %>
    <p>No loads Approved for Settlement are waiting to be finalized.</p>
  <% } %>
<% } else { %>
  <p class="muted">Your pay for each work week (Monday–Sunday) appears here once the weekly settlement is finalized for payroll. On percentage loads, the Drive Time line is your pay percentage of the drive-time fee. Flat/daily-rate loads include the full drive-time fee. Self load and detention are added in full. Fuel surcharge is not included.</p>
<% } %>

<h2>Finalized Settlements</h2>
<% if (approvedWeeks && approvedWeeks.length) { %>
  <% approvedWeeks.forEach(function (group) { %>
    <div class="card settlement-card settlement-final">
      <h3>Driver Settlement - Week of <%= group.range %></h3>
      <% if (user.role === 'admin') { %>
        <div><strong><%= group.driver_name %></strong><% if (group.pay_percentage != null) { %> · Pay <%= group.pay_percentage %><% } %></div>
      <% } %>
      <div class="settlement-meta">
        <%= group.loads.length %> load<%= group.loads.length === 1 ? '' : 's' %>
        · Qty/Wet Ton <%= group.qty %>
        · Finalized
      </div>
      <div class="settlement-amounts">
        <div class="pay-line">Driver Pay <%= usd(group.total) %></div>
        <% if (user.role === 'admin') { %><div class="total-load-pay-line">Total Load Pay (invoiced) <%= usd(group.totalLoadPay) %></div><% } %>
      </div>
      <div class="muted">Base <%= usd(group.base) %> · Drive Time <%= usd(group.drive) %> · Self Load <%= usd(group.self) %> · Detention <%= usd(group.detention) %></div>
      <% if (group.approved_by_name) { %>
        <div class="muted">Finalized by <%= group.approved_by_name %><% if (group.approved_at) { %> on <%= auditStamp(group.approved_at) %><% } %></div>
      <% } %>
      <p><a class="btn btn-secondary" href="/settlements/pdf?<%= user.role === 'admin' ? 'driver_id=' + group.driver_id + '&' : '' %>week_start=<%= group.week_start %>">Download PDF</a></p>
      <%- include('partials/settlement-loads', { loads: group.loads, user: user }) %>
    </div>
  <% }) %>
<% } else { %>
  <p>No finalized weekly settlements yet.</p>
<% } %>
<%- include('partials/close') %>
