<%- include('partials/open', { title: `Profile`, user: user, active: 'profile' }) %>
<h1>Profile</h1>
<div class="card">
      <p><strong>Name:</strong> <%= profile.name || '—' %></p>
      <p><strong>Email:</strong> <%= profile.email %></p>
      <p><strong>Phone:</strong> <%= profile.phone || '—' %></p>
      <p><strong>Address:</strong> <%= profile.address || '—' %></p>
      <p><strong>Role:</strong> <%= profile.role %></p>
      <% if (profile.role === 'driver') { %>
        <p><strong>Hire Date:</strong> <%= profile.hire_date || '—' %></p>
        <p><strong>Pay Percentage:</strong> <%= profile.pay_percentage || 'Not set' %>%</p>
      <% } %>
    </div>
    <% if (profile.role === 'driver') { %>
      <p style="margin-top:12px;font-size:14px;color:#666;">You can update your phone and address. Other employment and financial details are managed by Admin.</p>
    <% } %>
    <p style="margin-top:16px;"><a href="/logout">Sign Out</a></p>
<%- include('partials/close') %>
