<%- include('partials/open', { title: 'Your Profile', user: user, active: 'profile', headerTitle: 'Your Profile', backHref: '/' }) %>
<div class="profile-page">
  <div class="card profile-hero" id="profile-header">
    <img class="profile-pic profile-pic-lg" src="<%= profile.profile_pic || '/default-avatar.svg' %>" alt="">
    <div>
      <strong><%= profile.name || 'Your Profile' %></strong>
      <div class="muted"><%= profile.email %></div>
      <p class="header-actions"><a class="btn" href="#change-password">Reset Password</a></p>
    </div>
  </div>
  <% if (typeof saved !== 'undefined' && saved === 'password') { %><div class="all-clear">Password updated.</div><% } %>
  <% if (typeof saved !== 'undefined' && saved && saved !== 'password') { %><div class="all-clear">Changes saved.</div><% } %>
  <% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
  <div class="card" id="change-password">
    <h2>Reset / Change Password</h2>
    <p class="muted">Choose a new password. It takes effect the next time you sign in.</p>
    <form method="POST" action="/profile/password">
      <label for="new_password">New Password</label>
      <input id="new_password" type="password" name="new_password" autocomplete="new-password" required minlength="6">
      <label for="confirm_password">Confirm New Password</label>
      <input id="confirm_password" type="password" name="confirm_password" autocomplete="new-password" required minlength="6">
      <button type="submit">Update Password</button>
    </form>
  </div>
  <% if (profile.role === 'driver' && levels && levels.length) { %>
    <h2>Your Status</h2>
    <p class="muted">Green, yellow, and red levels stay visible here.</p>
    <%- include('partials/levels', { levels: levels, linked: false }) %>
  <% } %>
  <h1>Your Profile</h1>
  <p class="profile-lead"><%= profile.role === 'driver' ? 'Update your name, phone number, or address.' : 'Update your name, email, phone number, or address.' %></p>
  <form class="profile-form" method="POST" action="/profile">
    <label for="first_name">First Name</label>
    <input id="first_name" type="text" name="first_name" value="<%= profile.first_name || '' %>" autocomplete="given-name" required>
    <label for="last_name">Last Name</label>
    <input id="last_name" type="text" name="last_name" value="<%= profile.last_name || '' %>" autocomplete="family-name" required>
    <label for="email">Your Email</label>
    <div class="icon-input">
      <svg class="field-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7.5h16v9.2a1.3 1.3 0 0 1-1.3 1.3H5.3A1.3 1.3 0 0 1 4 16.7V7.5z"/><path d="m4.5 8 7.5 5.4L19.5 8"/></svg>
      <input id="email" type="email" name="email" value="<%= profile.email || '' %>" autocomplete="email" <%= profile.role === 'driver' ? 'disabled' : 'required' %>>
    </div>
    <% if (profile.role === 'driver') { %>
      <p class="field-help">Only an admin can change your login email.</p>
    <% } %>
    <label for="phone">Your Phone Number</label>
    <div class="icon-input">
      <svg class="field-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.2 4.6h2.2l1.2 3-1.6 1.1a11.2 11.2 0 0 0 5.3 5.3l1.1-1.6 3 1.2v2.2c0 .8-.6 1.5-1.4 1.6A13.6 13.6 0 0 1 6.6 6c.1-.8.8-1.4 1.6-1.4z"/></svg>
      <input id="phone" type="tel" name="phone" value="<%= profile.phone || '' %>" placeholder="Phone number" autocomplete="tel">
    </div>
    <label for="address">Address</label>
    <input id="address" type="text" name="address" value="<%= profile.address || '' %>" placeholder="Street address" autocomplete="street-address">
    <label for="city">City</label>
    <input id="city" type="text" name="city" value="<%= profile.city || '' %>" autocomplete="address-level2">
    <label for="state">State</label>
    <input id="state" type="text" name="state" value="<%= profile.state || '' %>" autocomplete="address-level1" maxlength="32">
    <label for="zip">Zip</label>
    <input id="zip" type="text" name="zip" value="<%= profile.zip || '' %>" autocomplete="postal-code" inputmode="numeric">
    <% if (profile.role === 'driver') { %>
      <label for="pay_percentage">Driver Pay (Pay %)</label>
      <input id="pay_percentage" type="text" value="<%= profile.pay_percentage != null && profile.pay_percentage !== '' ? profile.pay_percentage + '%' : 'Not set' %>" disabled>
      <label for="hire_date">Hire Date</label>
      <input id="hire_date" type="text" value="<%= profile.hire_date || 'Not set' %>" disabled>
      <p class="field-help">Only an admin can change driver pay and hire date.</p>
    <% } %>
    <button class="save-pill" type="submit">Save Changes</button>
  </form>
  <p class="profile-signout"><a href="/logout">Sign Out</a></p>
  <% if (profile.role !== 'driver') { %>
    <div class="card">
      <div><strong>Role</strong> <%= profile.role %></div>
    </div>
  <% } %>
</div>
<%- include('partials/close') %>
