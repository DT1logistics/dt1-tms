<%- include('partials/open', { title: 'Your Profile', user: user, active: 'profile', headerTitle: 'Your Profile', backHref: '/' }) %>
<div class="profile-page">
  <% if (profile.role === 'driver' && levels && levels.length) { %>
    <h2>Your Status</h2>
    <p class="muted">Green, yellow, and red levels stay visible here.</p>
    <%- include('partials/levels', { levels: levels, linked: false }) %>
  <% } %>
  <h1>Your Profile</h1>
  <p class="profile-lead"><%= profile.role === 'driver' ? 'Update your name, phone number, or address.' : 'Update your name, email, phone number, or address.' %></p>
  <% if (typeof saved !== 'undefined' && saved) { %><div class="all-clear">Changes saved.</div><% } %>
  <% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
  <form class="profile-form" method="POST" action="/profile">
    <label for="first_name">First Name</label>
    <input id="first_name" type="text" name="first_name" value="<%= profile.first_name || '' %>" autocomplete="given-name" required>
    <label for="last_name">Last Name</label>
    <input id="last_name" type="text" name="last_name" value="<%= profile.last_name || '' %>" autocomplete="family-name" required>
    <label for="email">Your Email</label>
    <div class="icon-input">
      <svg class="field-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7.5h16v9.2a1.3 1.3 0 0 1-1.3 1.3H5.3A1.3 1.3 0 0 1 4 16.7V7.5z"/><path d="m4.5 8 7.5 5.4L19.5 8"/></svg>
      <input id="email" type="email" name="email" value="<%= profile.email || '' %>" autocomplete="email" <%= profile.role === 'driver' ? 'disabled' : 'required' %>>
    </div>
    <% if (profile.role === 'driver') { %>
      <p class="field-help">Only an admin can change your login email.</p>
    <% } %>
    <label for="phone">Your Phone Number</label>
    <div class="icon-input">
      <svg class="field-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.2 4.6h2.2l1.2 3-1.6 1.1a11.2 11.2 0 0 0 5.3 5.3l1.1-1.6 3 1.2v2.2c0 .8-.6 1.5-1.4 1.6A13.6 13.6 0 0 1 6.6 6c.1-.8.8-1.4 1.6-1.4z"/></svg>
      <input id="phone" type="tel" name="phone" value="<%= profile.phone || '' %>" placeholder="Phone number" autocomplete="tel">
    </div>
    <label for="address">Your Address</label>
    <input id="address" type="text" name="address" value="<%= profile.address || '' %>" placeholder="Street, city, state, ZIP" autocomplete="street-address">
    <button class="save-pill" type="submit">Save Changes</button>
  </form>
  <p class="profile-signout"><a href="/logout">Sign Out</a></p>
  <% if (profile.role === 'driver') { %>
    <div class="card">
      <div><strong>Pay %</strong> <%= profile.pay_percentage != null && profile.pay_percentage !== '' ? profile.pay_percentage + '%' : 'Not set' %></div>
      <div><strong>Hire Date</strong> <%= profile.hire_date || '—' %></div>
      <p class="muted">Pay and hire date are managed by admin. CDL and medical card status is listed above.</p>
    </div>
  <% } else { %>
    <div class="card">
      <div><strong>Role</strong> <%= profile.role %></div>
    </div>
  <% } %>
</div>
<%- include('partials/close') %>
