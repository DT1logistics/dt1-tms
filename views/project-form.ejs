<%- include('partials/open', { title: (project && project.id ? 'Edit Project' : 'Add Project'), user: user, active: 'projects' }) %>
<h1><%= project && project.id ? 'Edit Project' : 'Add Project' %></h1>
<% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
    <form method="POST" action="<%= project && project.id ? '/projects/' + project.id : '/projects' %>">
      <label>Customer</label>
      <select name="customer_id" required>
        <option value="">-- Select Customer --</option>
        <% customers.forEach(customer => { %>
          <option value="<%= customer.id %>" <%= String(project.customer_id) === String(customer.id) ? 'selected' : '' %>><%= customer.name %></option>
        <% }) %>
      </select>
      <label>Project Name</label>
      <input type="text" name="project_name" required placeholder="e.g. Hunters Pad" value="<%= project.project_name || '' %>">
      <p class="muted">Display name is Customer - Project. A typed prefix such as "Synagro - Hunters Pad" is kept once.</p>
      <label>Default Rate ($)</label>
      <input type="number" step="0.01" name="default_rate" required value="<%= project.default_rate != null ? project.default_rate : '' %>">
      <label>Default Driver Pay Basis</label>
      <select name="default_driver_pay_type" id="default_driver_pay_type">
        <option value="percentage" <%= project.default_driver_pay_type === 'flat' ? '' : 'selected' %>>Percentage of Load (%)</option>
        <option value="flat" <%= project.default_driver_pay_type === 'flat' ? 'selected' : '' %>>Flat / Daily Rate ($)</option>
      </select>
      <label>Default Driver Flat / Daily Rate ($)</label>
      <input type="number" step="0.01" name="default_driver_flat_rate" value="<%= project.default_driver_flat_rate != null ? project.default_driver_flat_rate : '0.00' %>">
      <p class="muted">New loads for this project start with this driver pay basis. An admin can change it on each load.</p>
      <div class="check">
        <input type="checkbox" name="has_fuel_surcharge" id="has_fuel_surcharge" value="1" <%= project.has_fuel_surcharge ? 'checked' : '' %>>
        <label for="has_fuel_surcharge">Includes Fuel Surcharge</label>
      </div>
      <div class="check">
        <input type="checkbox" name="has_drive_time" id="has_drive_time" value="1" <%= project.has_drive_time ? 'checked' : '' %>>
        <label for="has_drive_time">Includes Drive Time Fee</label>
      </div>
      <div id="drive_time_wrap" style="<%= project.has_drive_time ? '' : 'display:none;' %>">
        <label>Default Drive Time Amount ($)</label>
        <input type="number" step="0.01" name="default_drive_time_amount" id="default_drive_time_amount" value="<%= project.default_drive_time_amount != null ? project.default_drive_time_amount : '0.00' %>">
      </div>
      <% if (project && project.id) { %>
        <label>Status</label>
        <select name="status">
          <option value="active" <%= project.status !== 'inactive' ? 'selected' : '' %>>Active</option>
          <option value="inactive" <%= project.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
        </select>
      <% } %>
      <button type="submit">Save Project</button>
    </form>
    <p><a href="/projects">Back to Projects</a></p>
<script>
    const driveBox = document.getElementById('has_drive_time');
    const driveWrap = document.getElementById('drive_time_wrap');
    const driveAmount = document.getElementById('default_drive_time_amount');
    function syncDrive(zeroIfOff) {
      const on = driveBox.checked;
      driveWrap.style.display = on ? 'block' : 'none';
      if (!on && zeroIfOff) driveAmount.value = '0.00';
    }
    driveBox.addEventListener('change', () => syncDrive(true));
    syncDrive(false);
  </script>
<%- include('partials/close') %>
