<%- include('partials/open', { title: (project && project.id ? 'Edit Project' : 'Add Project'), user: user, active: 'projects' }) %>
<h1><%= project && project.id ? 'Edit Project' : 'Add Project' %></h1>
<% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
    <form method="POST" action="<%= project && project.id ? '/projects/' + project.id : '/projects' %>">
      <label>Shipper</label>
      <select name="customer_id" required>
        <option value="">-- Select Shipper --</option>
        <% customers.forEach(customer => { %>
          <option value="<%= customer.id %>" <%= String(project.customer_id) === String(customer.id) ? 'selected' : '' %>><%= customer.name %></option>
        <% }) %>
      </select>
      <label>Project Name</label>
      <input type="text" name="project_name" required placeholder="e.g. Hunters Pad" value="<%= project.project_name || '' %>">
      <p class="muted">Display name is Shipper - Project. A typed prefix such as "Synagro - Hunters Pad" is kept once.</p>
      <label>Default Rate ($)</label>
      <input data-money="1" type="number" step="0.01" name="default_rate" required value="<%= project.default_rate != null ? project.default_rate : '' %>">
      <label>Default Driver Pay Basis</label>
      <select name="default_driver_pay_type" id="default_driver_pay_type">
        <option value="percentage" <%= project.default_driver_pay_type === 'flat' ? '' : 'selected' %>>Percentage of Load (%)</option>
        <option value="flat" <%= project.default_driver_pay_type === 'flat' ? 'selected' : '' %>>Flat / Daily Rate ($)</option>
      </select>
      <label>Driver Load Pay ($) <span class="muted">flat / daily rate paid to the driver</span></label>
      <input data-money="1" type="number" step="0.01" name="default_driver_flat_rate" value="<%= project.default_driver_flat_rate != null ? Number(project.default_driver_flat_rate).toFixed(2) : '0.00' %>">
      <label>Total Load Pay ($) <span class="muted">flat amount the customer pays DT1 per load</span></label>
      <input data-money="1" type="number" step="0.01" min="0" name="default_total_load_pay" placeholder="Blank = Qty × Rate" value="<%= project.default_total_load_pay != null && String(project.default_total_load_pay).trim() !== '' ? Number(project.default_total_load_pay).toFixed(2) : '' %>">
      <p class="muted">Both are fixed amounts, not percentages. New loads for this project start with this driver pay basis, Driver Load Pay, and Total Load Pay; an admin can change them on each load. When Total Load Pay is set it is what gets invoiced for the load (no separate fuel surcharge). Leave it blank to invoice Qty × Rate. Existing loads are not changed.</p>
      <label>Invoice billing quantity</label>
      <select name="invoice_billing_mode" id="invoice_billing_mode">
        <option value="actual" <%= project.invoice_billing_mode === 'flat_qty_1' ? '' : 'selected' %>>Actual quantity (tons or hours on the load)</option>
        <option value="flat_qty_1" <%= project.invoice_billing_mode === 'flat_qty_1' ? 'selected' : '' %>>Flat quantity 1 at the project default rate</option>
      </select>
      <div id="invoice_min_qty_wrap">
        <label>Minimum billable quantity <span class="muted">leave blank for none, e.g. 24 for a 24-ton minimum</span></label>
        <input type="number" step="0.001" min="0" name="invoice_min_qty" id="invoice_min_qty" value="<%= project.invoice_min_qty != null && String(project.invoice_min_qty).trim() !== '' ? project.invoice_min_qty : '' %>" placeholder="None">
      </div>
      <p class="muted">These settings control the customer invoice only. They do not change saved load data. "Flat quantity 1" bills each load as Qty 1 at this project's default rate (used for Uber Freight). A minimum quantity bills the greater of the load's quantity and this minimum (used for King George Pad at 24 tons).</p>
      <div class="check">
        <input type="checkbox" name="has_fuel_surcharge" id="has_fuel_surcharge" value="1" <%= project.has_fuel_surcharge ? 'checked' : '' %>>
        <label for="has_fuel_surcharge">Includes Fuel Surcharge</label>
      </div>
      <div class="check">
        <input type="checkbox" name="has_drive_time" id="has_drive_time" value="1" <%= project.has_drive_time ? 'checked' : '' %>>
        <label for="has_drive_time">Includes Drive Time Fee</label>
      </div>
      <div id="drive_time_wrap" style="<%= project.has_drive_time ? '' : 'display:none;' %>">
        <label>Default Drive Time Amount ($)</label>
        <input data-money="1" type="number" step="0.01" name="default_drive_time_amount" id="default_drive_time_amount" value="<%= project.default_drive_time_amount != null ? project.default_drive_time_amount : '0.00' %>">
      </div>
      <% if (project && project.id) { %>
        <label>Status</label>
        <select name="status">
          <option value="active" <%= project.status !== 'inactive' ? 'selected' : '' %>>Active</option>
          <option value="inactive" <%= project.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
        </select>
      <% } %>
      <button type="submit">Save Project</button>
    </form>
    <p><a href="/projects">Back to Projects</a></p>
<script>
    const driveBox = document.getElementById('has_drive_time');
    const driveWrap = document.getElementById('drive_time_wrap');
    const driveAmount = document.getElementById('default_drive_time_amount');
    function syncDrive(zeroIfOff) {
      const on = driveBox.checked;
      driveWrap.style.display = on ? 'block' : 'none';
      if (!on && zeroIfOff) driveAmount.value = '0.00';
    }
    driveBox.addEventListener('change', () => syncDrive(true));
    syncDrive(false);
    const billingMode = document.getElementById('invoice_billing_mode');
    const minWrap = document.getElementById('invoice_min_qty_wrap');
    function syncMinQty() {
      minWrap.style.display = billingMode.value === 'flat_qty_1' ? 'none' : 'block';
    }
    billingMode.addEventListener('change', syncMinQty);
    syncMinQty();
  </script>
<%- include('partials/close') %>
