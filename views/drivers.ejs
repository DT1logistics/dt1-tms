<%- include('partials/open', { title: 'Drivers', user: user, active: 'drivers' }) %>
<h1>Drivers</h1>
<p class="muted">Active drivers are listed below. Select a driver to open their profile.</p>
<a href="/drivers/new" class="btn">+ Add New Driver</a>

<div class="card" id="notification-settings">
  <p>SMTP Email: <span class="badge <%= notifications && notifications.email ? 'green' : 'yellow' %>"><%= notifications && notifications.email ? 'Connected' : 'Not configured' %></span>
  Twilio SMS: <span class="badge <%= notifications && notifications.sms ? 'green' : 'yellow' %>"><%= notifications && notifications.sms ? 'Connected' : 'Not configured' %></span></p>
  <p class="muted">Welcome messages, activation, and password resets are on each driver's profile.</p>
</div>

<% const activeDrivers = drivers.filter(function (d) { return (d.status || 'active') !== 'inactive'; }); %>
<% const inactiveDrivers = drivers.filter(function (d) { return d.status === 'inactive'; }); %>

<% function driverRow(d) { %>
  <a class="driver-list-row" href="/drivers/<%= d.id %>">
    <img class="profile-pic" src="<%= d.profile_pic || '/default-avatar.svg' %>" alt="">
    <div class="driver-list-main">
      <strong><%= d.name || 'Unnamed' %></strong>
      <div class="muted"><%= d.email %></div>
      <div class="muted"><%= d.phone || 'No phone' %></div>
      <div class="muted">Pay <%= d.pay_percentage != null && d.pay_percentage !== '' ? d.pay_percentage + '%' : 'not set' %></div>
    </div>
    <div class="driver-list-side">
      <span class="badge <%= d.compliance ? d.compliance.level : 'green' %>"><%= d.compliance ? d.compliance.label : 'Compliant' %></span>
      <span class="open-label">Open Driver Profile →</span>
    </div>
  </a>
<% } %>

<h2>Active Drivers (<%= activeDrivers.length %>)</h2>
<% if (activeDrivers.length) { %>
  <div class="driver-list">
    <% activeDrivers.forEach(driverRow); %>
  </div>
<% } else { %>
  <p>No active drivers.</p>
<% } %>

<details class="inactive-drivers" id="inactive-drivers">
  <summary>Inactive Drivers (<%= inactiveDrivers.length %>)</summary>
  <% if (inactiveDrivers.length) { %>
    <div class="driver-list">
      <% inactiveDrivers.forEach(driverRow); %>
    </div>
  <% } else { %>
    <p>No inactive drivers.</p>
  <% } %>
</details>
<%- include('partials/close') %>
