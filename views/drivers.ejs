<%- include('partials/open', { title: `Drivers`, user: user, active: 'drivers' }) %>
<h1>Drivers</h1>
<a href="/drivers/new" class="btn">+ Add New Driver</a>
    <% if (drivers.length === 0) { %>
      <p>No drivers yet.</p>
    <% } else { %>
      <% drivers.forEach(d => { %>
        <div class="card">
          <a href="/drivers/<%= d.id %>" style="text-decoration:none;color:inherit;">
            <strong><%= d.name || 'Unnamed' %></strong><br>
            <%= d.email %><br>
            Pay: <%= d.pay_percentage ? d.pay_percentage + '%' : 'Not set' %> · <%= d.status %>
          </a>
        </div>
      <% }) %>
    <% } %>
<%- include('partials/close') %>
