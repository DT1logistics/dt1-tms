<%- include('partials/open', { title: `Receipts`, user: user, active: 'receipts' }) %>
<h1>Receipts</h1>
<a href="/receipts/new" style="display:inline-block;background:#1B365D;color:white;padding:10px 16px;border-radius:8px;text-decoration:none;margin-bottom:16px;">+ New Receipt</a>
    <% if (receipts && receipts.length) { %>
      <% receipts.forEach(r => { %>
        <div style="background:white;padding:16px;border-radius:10px;margin-bottom:12px;">
          <strong><%= r.expense_date %></strong> — <%= r.original_name || 'No file' %><br>
          Status: <span style="font-weight:bold;"><%= r.status %></span><br>
          Uploaded by: <%= r.uploader_name || 'Unknown' %>
          <% if (user.role === 'admin' && r.status === 'pending') { %>
            <form method="POST" action="/receipts/<%= r.id %>/approve" style="margin-top:8px;">
              <button type="submit" style="background:#155724;color:white;border:none;padding:6px 12px;border-radius:6px;">Approve</button>
            </form>
          <% } %>
        </div>
      <% }) %>
    <% } else { %>
      <p>No receipts yet.</p>
    <% } %>
    <p>Approved receipts are copied to SharePoint and made available to Ava for QuickBooks matching.</p>
<%- include('partials/close') %>
