<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= customer.name %> - DT1 Logistics</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; background: #f5f7fa; padding-bottom: 70px; }
    .header { background: #1B365D; color: white; padding: 16px 20px; }
    .content { padding: 16px; max-width: 800px; margin: 0 auto; }
    .card { background: white; border-radius: 10px; padding: 16px; margin-bottom: 12px; box-shadow: 0 2px 6px rgba(0,0,0,0.08); }
    label { display: block; margin-top: 12px; font-weight: bold; color: #333; }
    input { width: 100%; padding: 12px; margin-top: 4px; border: 1px solid #ddd; border-radius: 8px; box-sizing: border-box; }
    input[type="checkbox"] { width: auto; padding: 0; margin: 0; }
    .check { display: flex; align-items: center; gap: 8px; margin-top: 14px; }
    .check label { margin: 0; }
    button, .btn { display: inline-block; background: #1B365D; color: white; padding: 10px 16px; border: none; border-radius: 8px; text-decoration: none; cursor: pointer; }
    button { margin-top: 16px; }
    .error { color: #c0392b; }
    .muted { color: #555; font-size: 14px; }
    .bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; background: white; border-top: 1px solid #ddd; display: flex; justify-content: space-around; padding: 10px 0; }
    .bottom-nav a { text-decoration: none; color: #1B365D; font-size: 12px; text-align: center; }
  </style>
</head>
<body>
  <div class="header"><strong><%= customer.name %></strong></div>
  <div class="content">
    <p><a href="/customers">All Customers</a> · <a href="/customers/<%= customer.id %>/edit">Edit Customer</a></p>
    <div class="card">
      <div><strong>Point of Contact:</strong> <%= customer.poc_name || '—' %></div>
      <div><strong>Phone:</strong> <%= customer.poc_phone || '—' %></div>
      <div><strong>Email:</strong> <%= customer.poc_email || '—' %></div>
      <div><strong>Billing Address:</strong> <%= customer.address_line1 || '—' %></div>
      <% if (customer.address_line2) { %><div><%= customer.address_line2 %></div><% } %>
      <div><strong>Terms:</strong> <%= customer.terms || 'Net 30' %></div>
      <div class="muted">Status: <%= customer.status || 'active' %></div>
    </div>

    <h3>Projects (<%= projects.length %>)</h3>
    <% if (!projects.length) { %>
      <p>No projects yet.</p>
    <% } else { %>
      <% projects.forEach(project => { %>
        <div class="card">
          <strong><%= project.display_name %></strong>
          <div class="muted">Default Rate: $<%= money(project.default_rate) %></div>
          <div class="muted">Includes Fuel Surcharge: <%= project.has_fuel_surcharge ? 'Yes' : 'No' %></div>
          <div class="muted">Includes Drive Time Fee: <%= project.has_drive_time ? 'Yes' : 'No' %><% if (project.has_drive_time) { %> — $<%= money(project.default_drive_time_amount) %><% } %></div>
          <div class="muted">Status: <%= project.status || 'active' %></div>
          <p><a href="/projects/<%= project.id %>/edit">Edit Project</a></p>
        </div>
      <% }) %>
    <% } %>

    <div class="card">
      <h3>Add Project</h3>
      <% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
      <form method="POST" action="/customers/<%= customer.id %>/projects" id="projectForm">
        <label>Project Name</label>
        <input type="text" name="project_name" required placeholder="e.g. Hunters Pad" value="<%= typeof draft !== 'undefined' && draft.project_name ? draft.project_name : '' %>">
        <p class="muted">Saved as <%= customer.name %> - Project Name. If the name already starts with "<%= customer.name %> - ", the prefix is not repeated.</p>
        <label>Default Rate ($)</label>
        <input type="number" step="0.01" name="default_rate" required value="<%= typeof draft !== 'undefined' && draft.default_rate ? draft.default_rate : '' %>">
        <div class="check">
          <input type="checkbox" name="has_fuel_surcharge" id="has_fuel_surcharge" value="1" <%= typeof draft !== 'undefined' && (draft.has_fuel_surcharge === '1' || draft.has_fuel_surcharge === 'on') ? 'checked' : '' %>>
          <label for="has_fuel_surcharge">Includes Fuel Surcharge</label>
        </div>
        <div class="check">
          <input type="checkbox" name="has_drive_time" id="has_drive_time" value="1" <%= typeof draft !== 'undefined' && (draft.has_drive_time === '1' || draft.has_drive_time === 'on') ? 'checked' : '' %>>
          <label for="has_drive_time">Includes Drive Time Fee</label>
        </div>
        <div id="drive_time_wrap" style="display:none;">
          <label>Default Drive Time Amount ($)</label>
          <input type="number" step="0.01" name="default_drive_time_amount" id="default_drive_time_amount" value="<%= typeof draft !== 'undefined' && draft.default_drive_time_amount ? draft.default_drive_time_amount : '0.00' %>">
        </div>
        <button type="submit">Save Project</button>
      </form>
    </div>
  </div>
  <div class="bottom-nav">
    <a href="/">Home</a>
    <a href="/loads">Loads</a>
    <a href="/receipts">Receipts</a>
    <a href="/fuel">Fuel</a>
    <a href="/profile">Profile</a>
  </div>
  <script>
    const driveBox = document.getElementById('has_drive_time');
    const driveWrap = document.getElementById('drive_time_wrap');
    const driveAmount = document.getElementById('default_drive_time_amount');
    function syncDrive(zeroIfOff) {
      const on = driveBox.checked;
      driveWrap.style.display = on ? 'block' : 'none';
      if (!on && zeroIfOff) driveAmount.value = '0.00';
    }
    driveBox.addEventListener('change', () => syncDrive(true));
    syncDrive(false);
  </script>
</body>
</html>
