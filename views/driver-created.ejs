<%- include('partials/open', { title: 'Driver Created', user: user, active: 'drivers' }) %>
<h1>Driver Created</h1>
<div class="card">
  <p><strong><%= name %></strong> has been added.</p>
  <p>Email / Username: <strong><%= email %></strong></p>
  <p>Temporary Password:</p>
  <div class="temp"><%= tempPassword %></div>
  <p>They will be prompted to set their own password the first time they sign in.</p>
  <form method="POST" action="/drivers/<%= driverId %>/send-welcome">
    <button type="submit">Send Welcome Email</button>
  </form>
</div>
<%- include('partials/welcome-email', { welcome: welcome }) %>
<p><a href="/drivers">Back to Drivers</a></p>
<%- include('partials/close') %>
