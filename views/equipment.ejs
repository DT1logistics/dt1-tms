<%- include('partials/open', { title: 'Equipment', user: user, active: 'equipment' }) %>
<h1>Equipment</h1>
<a href="/equipment/new" class="btn">+ Add Equipment</a>

<% function equipmentCard(item) { %>
  <div class="card">
    <div class="counts">
      <strong><a href="/equipment/<%= item.id %>"><%= item.number || 'Unnumbered' %></a></strong>
      <% if (item.maintenance_status === 'out_of_service') { %>
        <span class="badge red">Out of service</span>
      <% } else if (item.maintenance_status === 'maintenance') { %>
        <span class="badge yellow">In maintenance</span>
      <% } else { %>
        <span class="badge green">Active</span>
      <% } %>
    </div>
    <div class="equip-meta"><strong>VIN#:</strong> <%= item.vin || '—' %></div>
    <div class="equip-meta"><strong>Year:</strong> <%= item.year || '—' %></div>
    <div class="equip-meta"><strong>Make:</strong> <%= item.make || '—' %></div>
    <div class="equip-meta"><strong>Model:</strong> <%= item.model || '—' %></div>
    <div class="equip-meta"><strong>Description:</strong> <%= item.description || '—' %></div>
    <div class="muted">Status: <%= item.status === 'inactive' ? 'Inactive' : 'Active' %></div>
    <div class="muted"><%= item.ownership || 'Ownership not set' %></div>
    <div>
      Registration Expiration:
      <% if (item.registration_expiration) { %>
        <span class="badge <%= getStatusClass(item.registration_expiration) %>"><%= getStatusText(item.registration_expiration) %></span>
        <%= item.registration_expiration %>
      <% } else { %>—<% } %>
    </div>
    <div>
      Annual DOT Inspection:
      <% if (item.inspection_expiration) { %>
        <span class="badge <%= getStatusClass(item.inspection_expiration) %>"><%= getStatusText(item.inspection_expiration) %></span>
        <%= item.inspection_expiration %>
      <% } else { %>—<% } %>
    </div>
    <% const cost = (typeof expenseTotals !== 'undefined' && expenseTotals[String(item.id)]) || { ytd: 0, allTime: 0, count: 0 }; %>
    <div class="equip-cost"><strong>Maintenance Cost:</strong> YTD <%= expenseYear %> $<%= money(cost.ytd) %> · All-time $<%= money(cost.allTime) %> <span class="muted">(<%= cost.count %> item<%= cost.count === 1 ? '' : 's' %>)</span></div>
    <p><a href="/equipment/<%= item.id %>#expenses">Expenses / Maintenance Log</a> · <a href="/equipment/<%= item.id %>/edit">Edit</a></p>
  </div>
<% } %>

<h2>Trucks</h2>
<% if (trucks.length) { trucks.forEach(equipmentCard); } else { %><p>No trucks yet.</p><% } %>
<h2>Trailers</h2>
<% if (trailers.length) { trailers.forEach(equipmentCard); } else { %><p>No trailers yet.</p><% } %>
<%- include('partials/close') %>
