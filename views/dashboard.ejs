<%- include('partials/open', { title: 'Home', user: user, active: 'home' }) %>
<% if (user.role === 'driver') { %>
  <h1>Home</h1>
  <h2>Your Status</h2>
  <p class="muted">Your CDL license and medical card. Yellow is 15 to 45 days from expiration. Red is missing, expired, or within 14 days.</p>
  <div class="counts">
    <span class="badge red"><%= redCount %> Red</span>
    <span class="badge yellow"><%= yellowCount %> Yellow</span>
    <span class="badge green"><%= greenCount %> Green</span>
  </div>
  <%- include('partials/levels', { levels: levels }) %>
<% } else { %>
  <h1>Home</h1>
  <p class="muted">Items that are yellow or red and need attention.</p>
  <% if (!alerts.length) { %>
    <div class="all-clear">All Clear — No Yellow or Red Items</div>
  <% } else { %>
    <h2>Action Required — Red &amp; Yellow Alerts</h2>
    <div class="counts">
      <span class="badge red"><%= redCount %> Red</span>
      <span class="badge yellow"><%= yellowCount %> Yellow</span>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Level</th>
            <th>Category</th>
            <th>Item</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% alerts.forEach(function (alert) { %>
            <tr>
              <td><span class="badge <%= alert.level %>"><%= alert.level === 'red' ? 'Red' : 'Yellow' %></span></td>
              <td><%= alert.category %></td>
              <td><%= alert.name %></td>
              <td><%= alert.detail %></td>
              <td><a href="<%= alert.href %>">Open</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
  <h2>Quick Access</h2>
  <div class="cards">
    <a class="quick" href="/customers"><strong>Customers &amp; Projects</strong><span>Billing contacts, project rates, fuel surcharge, and drive time.</span></a>
    <a class="quick" href="/loads"><strong>Loads</strong><span>Enter tickets, quantities, and project charges.</span></a>
    <a class="quick" href="/drivers"><strong>Drivers</strong><span>Driver profiles, CDL, and medical cards.</span></a>
    <a class="quick" href="/equipment"><strong>Equipment</strong><span>Trucks, trailers, registration, and inspections.</span></a>
    <a class="quick" href="/receipts"><strong>Receipts</strong><span>Expense receipts for approval.</span></a>
    <a class="quick" href="/fuel-rate"><strong>Fuel Rate</strong><span>Weekly EIA Central Atlantic surcharge.</span></a>
    <a class="quick" href="/compliance"><strong>Compliance</strong><span>FMCSA, HVUT, UCR, IFTA, and insurance dates.</span></a>
    <a class="quick" href="/settlements"><strong>Settlements &amp; Invoices</strong><span>Driver pay and weekly customer invoices.</span></a>
  </div>
<% } %>
<%- include('partials/close') %>
