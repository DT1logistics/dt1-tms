<%- include('partials/open', { title: 'Home', user: user, active: 'home' }) %>
<% if (user.role === 'driver') { %>
  <h1>Home</h1>
  <h2>Your Status</h2>
  <p class="muted">Your CDL license and medical card. Yellow is 15 to 45 days from expiration. Red is missing, expired, or within 14 days.</p>
  <div class="counts">
    <span class="badge red"><%= redCount %> Red</span>
    <span class="badge yellow"><%= yellowCount %> Yellow</span>
    <span class="badge green"><%= greenCount %> Green</span>
  </div>
  <%- include('partials/levels', { levels: levels }) %>
  <%- include('partials/assigned-loads-banner', { assignedLoads: typeof assignedLoads !== 'undefined' ? assignedLoads : [] }) %>
  <h2>Your Loads</h2>
  <p class="muted">Approved loads stay here until an admin approves the weekly driver settlement. Driver pay does not include fuel surcharge.</p>
  <%- include('partials/week-summaries', { weekGroups: weekGroups, undatedLoads: undatedLoads, user: user }) %>
<% } else { %>
  <h1>Home</h1>
  <h2>Compliance</h2>
  <p class="muted">Red is out of compliance. Yellow is expiring soon or another warning. A tile turns red only when its out-of-compliance count is above zero.</p>
  <%- include('partials/compliance-tiles', { complianceTiles: complianceTiles }) %>
  <h2>Quick Access</h2>
  <div class="cards">
    <a class="quick" href="/shippers"><strong>Shippers &amp; Projects</strong><span>Billing contacts, project rates, fuel surcharge, and drive time.</span></a>
    <a class="quick" href="/loads"><strong>Loads</strong><span>Enter tickets, quantities, and project charges.</span></a>
    <a class="quick" href="/drivers"><strong>Drivers</strong><span>Driver profiles, CDL, and medical cards.</span></a>
    <a class="quick" href="/equipment"><strong>Equipment</strong><span>Trucks, hotshots, trailers, registration, and inspections.</span></a>
    <a class="quick" href="/receipts"><strong>Receipts</strong><span>Expense receipts for approval.</span></a>
    <a class="quick" href="/fuel-rate"><strong>Fuel Rate</strong><span>Weekly EIA Central Atlantic surcharge.</span></a>
    <a class="quick" href="/compliance"><strong>Compliance</strong><span>FMCSA, HVUT, UCR, IFTA, and insurance dates.</span></a>
    <a class="quick" href="/settlements"><strong>Settlements &amp; Invoices</strong><span>Driver pay and weekly shipper invoices.</span></a>
  </div>
<% } %>
<%- include('partials/close') %>
