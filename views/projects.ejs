<%- include('partials/open', { title: `Projects`, user: user, active: 'projects' }) %>
<h1>Projects</h1>
<a href="/projects/new" class="btn">+ Add Project</a>
    <a href="/customers" class="btn">Customers</a>
    <% if (!projects.length) { %>
      <p>No projects yet.</p>
    <% } else { %>
      <% projects.forEach(project => { %>
        <div class="card">
          <strong><%= project.display_name %></strong>
          <div class="muted"><%= project.customer_name %> · <%= project.status || 'active' %></div>
          <div>Default Rate: $<%= money(project.default_rate) %></div>
          <div class="muted">Fuel Surcharge: <%= project.has_fuel_surcharge ? 'Yes' : 'No' %> · Drive Time: <%= project.has_drive_time ? '$' + money(project.default_drive_time_amount) : 'No' %></div>
          <p><a href="/projects/<%= project.id %>/edit">Edit</a> · <a href="/customers/<%= project.customer_id %>">Customer</a></p>
        </div>
      <% }) %>
    <% } %>
<%- include('partials/close') %>
