<%- include('partials/open', { title: `Projects`, user: user, active: 'projects' }) %>
<h1>Projects</h1>
<a href="/projects/new" class="btn">+ Add Project</a>
    <a href="/shippers" class="btn">Shippers</a>
    <% if (!projects.length) { %>
      <p>No projects yet.</p>
    <% } else { %>
      <% projects.forEach(project => { %>
        <div class="card">
          <strong><%= project.display_name %></strong>
          <div class="muted"><%= project.customer_name %> · <%= project.status || 'active' %></div>
          <div>Default Rate: <%= usd(project.default_rate) %></div>
          <div>Contractor Load Pay: <%= project.default_driver_pay_type === 'flat' ? 'Flat / Daily Rate ' + usd(project.default_driver_flat_rate) : 'Percentage of Load' %></div>
          <div>Total Load Pay: <%= project.default_total_load_pay != null && String(project.default_total_load_pay).trim() !== '' ? usd(project.default_total_load_pay) : 'Not set (Qty × Rate)' %></div>
          <div class="muted">Fuel Surcharge: <%= project.has_fuel_surcharge ? 'Yes' : 'No' %> · Drive Time: <%= project.has_drive_time ? usd(project.default_drive_time_amount) : 'No' %></div>
          <p><a href="/projects/<%= project.id %>/edit">Edit</a> · <a href="/shippers/<%= project.customer_id %>">Shipper</a></p>
        </div>
      <% }) %>
    <% } %>
<%- include('partials/close') %>
