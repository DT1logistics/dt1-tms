<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Projects - DT1 Logistics</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; background: #f5f7fa; padding-bottom: 70px; }
    .header { background: #1B365D; color: white; padding: 16px 20px; }
    .content { padding: 16px; max-width: 900px; margin: 0 auto; }
    .card { background: white; border-radius: 10px; padding: 16px; margin-bottom: 12px; box-shadow: 0 2px 6px rgba(0,0,0,0.08); }
    .btn { display: inline-block; background: #1B365D; color: white; padding: 10px 16px; border-radius: 8px; text-decoration: none; margin: 0 8px 16px 0; }
    .muted { color: #555; font-size: 14px; }
    .bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; background: white; border-top: 1px solid #ddd; display: flex; justify-content: space-around; padding: 10px 0; }
    .bottom-nav a { text-decoration: none; color: #1B365D; font-size: 12px; text-align: center; }
  </style>
</head>
<body>
  <div class="header"><strong>Projects</strong></div>
  <div class="content">
    <a href="/projects/new" class="btn">+ Add Project</a>
    <a href="/customers" class="btn">Customers</a>
    <% if (!projects.length) { %>
      <p>No projects yet.</p>
    <% } else { %>
      <% projects.forEach(project => { %>
        <div class="card">
          <strong><%= project.display_name %></strong>
          <div class="muted"><%= project.customer_name %> · <%= project.status || 'active' %></div>
          <div>Default Rate: $<%= money(project.default_rate) %></div>
          <div class="muted">Fuel Surcharge: <%= project.has_fuel_surcharge ? 'Yes' : 'No' %> · Drive Time: <%= project.has_drive_time ? '$' + money(project.default_drive_time_amount) : 'No' %></div>
          <p><a href="/projects/<%= project.id %>/edit">Edit</a> · <a href="/customers/<%= project.customer_id %>">Customer</a></p>
        </div>
      <% }) %>
    <% } %>
  </div>
  <div class="bottom-nav">
    <a href="/">Home</a>
    <a href="/loads">Loads</a>
    <a href="/receipts">Receipts</a>
    <a href="/fuel">Fuel</a>
    <a href="/profile">Profile</a>
  </div>
</body>
</html>
