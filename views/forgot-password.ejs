<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password - DT1 Logistics</title>
  <%- include('partials/head-icons') %>
  <link rel="stylesheet" href="/app.css">
</head>
<body class="login-page">
  <div class="login-box">
    <img class="login-logo" src="<%= logoSrc %>" alt="DT1 Logistics" onerror="this.onerror=null;this.src='/logo.svg'">
    <h1>Reset Password</h1>
    <% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
    <% if (sent) { %>
      <div class="all-clear"><%= message %></div>
    <% } else { %>
      <p class="muted">Enter the email on your account. If it matches an account, we'll email a link to choose a new password. The link expires in one hour. Your current password stays the same until you use the link.</p>
      <form method="POST" action="/forgot-password">
        <label for="email">Email</label>
        <input id="email" type="email" name="email" placeholder="Email" required>
        <button type="submit">Email Reset Link</button>
      </form>
    <% } %>
    <p class="forgot-link"><a href="/login">Back to Sign In</a></p>
  </div>
</body>
</html>
