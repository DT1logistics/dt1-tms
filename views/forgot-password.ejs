<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password - DT1 Logistics</title>
  <%- include('partials/head-icons') %>
  <link rel="stylesheet" href="/app.css">
</head>
<body class="login-page">
  <div class="login-box">
    <img class="login-logo" src="<%= logoSrc %>" alt="DT1 Logistics" onerror="this.onerror=null;this.src='/logo.svg'">
    <h1>Reset Password</h1>
    <% if (sent) { %>
      <div class="all-clear">If that email is on file, a temporary password was emailed, or an admin was alerted to reset it for you.</div>
    <% } else { %>
      <p class="muted">Enter the email on your driver account. If email delivery is available, you'll receive a temporary password. Otherwise an admin is alerted on the dashboard.</p>
      <form method="POST" action="/forgot-password">
        <label for="email">Email</label>
        <input id="email" type="email" name="email" placeholder="Email" required>
        <button type="submit">Request Password Reset</button>
      </form>
    <% } %>
    <p class="forgot-link"><a href="/login">Back to Sign In</a></p>
  </div>
</body>
</html>
