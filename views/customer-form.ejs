<%- include('partials/open', { title: (customer && customer.id ? 'Edit Shipper' : 'Add Shipper'), user: user, active: 'shippers' }) %>
<h1><%= customer && customer.id ? 'Edit Shipper' : 'Add Shipper' %></h1>
<% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
    <form method="POST" action="<%= customer && customer.id ? '/shippers/' + customer.id : '/shippers' %>">
      <label>Shipper Name</label>
      <input type="text" name="name" value="<%= customer.name || '' %>" placeholder="e.g. Synagro" required>
      <label>Billing Address (Street)</label>
      <input type="text" name="address_line1" value="<%= customer.address_line1 || '' %>" placeholder="e.g. 1681 Tappahannock BLVD">
      <label>Billing Address (City, State, Zip)</label>
      <input type="text" name="address_line2" value="<%= customer.address_line2 || '' %>" placeholder="e.g. Tappahannock, VA 22560">
      <label>Point of Contact Name</label>
      <input type="text" name="poc_name" value="<%= customer.poc_name || '' %>">
      <label>Point of Contact Phone Number</label>
      <input type="tel" name="poc_phone" value="<%= customer.poc_phone || '' %>" placeholder="(804) 761-2054">
      <label>Point of Contact Email Address</label>
      <input type="email" name="poc_email" value="<%= customer.poc_email || '' %>" placeholder="cahayes@synagro.com">
      <label>Terms</label>
      <input type="text" name="terms" value="<%= customer.terms || 'Net 30' %>">
      <% if (customer && customer.id) { %>
        <label>Status</label>
        <select name="status">
          <option value="active" <%= customer.status !== 'inactive' ? 'selected' : '' %>>Active</option>
          <option value="inactive" <%= customer.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
        </select>
      <% } %>
      <button type="submit">Save Shipper</button>
    </form>
    <p><a href="<%= customer && customer.id ? '/shippers/' + customer.id : '/shippers' %>">Back</a></p>
<%- include('partials/close') %>
