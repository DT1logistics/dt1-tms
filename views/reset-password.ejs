<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Choose a New Password - DT1 Logistics</title>
  <%- include('partials/head-icons') %>
  <link rel="stylesheet" href="/app.css">
</head>
<body class="login-page">
  <div class="login-box">
    <img class="login-logo" src="<%= logoSrc %>" alt="DT1 Logistics" onerror="this.onerror=null;this.src='/logo.svg'">
    <h1>Choose a New Password</h1>
    <% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
    <% if (valid) { %>
      <p class="muted">This link works once. Choose a new password for this account.</p>
      <form method="POST" action="/reset-password/<%= encodeURIComponent(token) %>" autocomplete="on">
        <label for="username">Email</label>
        <input id="username" type="email" name="username" autocomplete="username" value="<%= email || '' %>">
        <label for="new_password">New password</label>
        <input id="new_password" type="password" name="new_password" autocomplete="new-password" required minlength="6">
        <label for="confirm_password">Confirm new password</label>
        <input id="confirm_password" type="password" name="confirm_password" autocomplete="new-password" required minlength="6">
        <button type="submit">Save password</button>
      </form>
    <% } else { %>
      <p class="forgot-link"><a href="/forgot-password">Request a new reset link</a></p>
    <% } %>
    <p class="forgot-link"><a href="/login">Back to Sign In</a></p>
  </div>
</body>
</html>
