<%- include('partials/open', { title: `Loads`, user: user, active: 'loads' }) %>
<h1>Loads</h1>
<a href="/loads/new" class="btn">+New Load</a>
<% if (typeof deleted !== 'undefined' && deleted) { %><div class="all-clear">Load deleted.</div><% } %>
<% if (user.role === 'driver') { %>
  <p class="muted">Loads waiting for weekly settlement approval are grouped by Monday–Sunday week. Settled weeks are on Settlements.</p>
  <%- include('partials/week-summaries', { weekGroups: weekGroups, undatedLoads: undatedLoads, user: user }) %>
<% } else if (loads.length === 0) { %>
  <p>No loads yet.</p>
<% } else { %>
  <% loads.forEach(function (load) { %>
    <%- include('partials/load-card', { load: load, user: user }) %>
  <% }) %>
<% } %>
<%- include('partials/close') %>
