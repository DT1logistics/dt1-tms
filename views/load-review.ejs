<%- include('partials/open', { title: 'Review Load', user: user, active: 'loads', headerTitle: 'Review Load', backHref: '/loads', bodyClass: 'load-screen' }) %>
<h1>Review Load <%= displayLoadNumber(load.load_number) %></h1>
<p>
  <span class="status <%= loadStatusClass(load.status, load.settlement_status, load) %>"><%= loadStatusLabel(load.status, load.settlement_status, load) %></span>
  <% const origin = loadOriginLabel(load); %>
  <% if (origin) { %><span class="origin-badge"><%= origin %></span><% } %>
  <% if (load.load_date && (load.status === 'approved' || load.settlement_status === 'approved')) { %>
    <span class="muted"><%= settlementWeekLabel(load.load_date) %></span>
  <% } %>
</p>
<% const assignmentNotice = (typeof assignedLoadNotice !== 'undefined' && assignedLoadNotice) ? assignedLoadNotice : null; %>
<% const assignmentSmsOn = !!(assignmentNotice && assignmentNotice.smsStatus && assignmentNotice.smsStatus !== 'Not selected'); %>
<% const assignmentEmailOn = !!(assignmentNotice && assignmentNotice.emailStatus && assignmentNotice.emailStatus !== 'Not selected'); %>
<% if (saved === 'assigned') { %>
  <div class="all-clear">Load assigned to <%= load.driver_name || 'contractor' %> and saved to their Drafts.<% if (assignmentSmsOn) { %> Text message notification triggered: &ldquo;DT1 Logistics has assigned you a new Load&rdquo;.<% } %></div>
<% } %>
<% if (assignmentNotice && (assignmentSmsOn || assignmentEmailOn)) { %>
  <div class="card assigned-sms-card" id="assigned-sms-card">
    <h2>📲 Contractor Load Assignment Text Message Notification</h2>
    <p><strong>Contractor:</strong> <%= assignmentNotice.driverName || load.driver_name || 'Unassigned' %> (<%= assignmentNotice.driverPhone || 'No phone on file' %><% if (assignmentNotice.driverEmail) { %> · <%= assignmentNotice.driverEmail %><% } %>)</p>
    <p>
      <% if (assignmentSmsOn) { %>
      <strong>Text (SMS) Status:</strong>
      <span class="badge <%= (assignmentNotice.smsStatus === 'Sent' || String(assignmentNotice.smsStatus).indexOf('Sent via') === 0) ? 'green' : 'yellow' %>"><%= assignmentNotice.smsStatus %></span>
      <% } %>
      <% if (assignmentEmailOn) { %>
        <% if (assignmentSmsOn) { %>&nbsp;·&nbsp;<% } %>
        <strong>Email Status:</strong>
        <span class="badge <%= assignmentNotice.emailStatus === 'Sent' ? 'green' : 'yellow' %>"><%= assignmentNotice.emailStatus %></span>
      <% } %>
    </p>
    <pre class="sms-preview" id="assigned-sms-text"><%= assignmentNotice.smsText %></pre>
    <div class="welcome-actions">
      <% if (assignmentSmsOn && assignmentNotice.smsHref) { %>
        <a class="btn" href="<%= assignmentNotice.smsHref %>">Open Text Message (SMS)</a>
      <% } %>
      <% if (assignmentEmailOn && assignmentNotice.mailto) { %>
        <a class="btn btn-secondary" href="<%= assignmentNotice.mailto %>">Open Email</a>
      <% } %>
      <a class="btn btn-secondary" href="/communications">View in Communications Log</a>
    </div>
  </div>
<% } %>
<% if (saved === 'approved') { %><div class="all-clear"><%= loadStatusLabel(load.status, load.settlement_status, load) %><%= load.load_date ? ' · ' + settlementWeekLabel(load.load_date) : '' %>.</div><% } %>
<% if (saved === 'rejected') { %><div class="reject-note">Load sent back to the contractor as Draft.</div><% } %>
<% if (saved === 'edited') { %><div class="all-clear">Load saved.</div><% } %>
<% if (saved === 'flag') { %><div class="all-clear">Missing info flag saved.</div><% } %>
<% if (saved === 'review') { %><div class="all-clear">Review notes saved.</div><% } %>
<% if (saved === 'cleared') { %><div class="all-clear">Missing-info flag cleared.</div><% } %>
<% if (saved === 'accepted') { %><div class="all-clear">Load accepted.</div><% } %>
<% if (saved === 'review-rejected') { %><div class="reject-note">Load rejected.<% if (load.status === 'draft' && load.rejection_reason) { %> It was sent back to the contractor as Draft.<% } %></div><% } %>
<% if (saved === 'locked') { %><div class="reject-note">This load's weekly settlement is finalized, so the load is locked: no edits, no reject, no delete.</div><% } %>
<% if (saved === 'delete-blocked') { %><div class="reject-note">This load is Approved for Settlement, so it cannot be deleted. Reject it back to Draft or edit it instead.</div><% } %>
<% if (saved === 'need-reason') { %><div class="reject-note">A reason is required to reject a load.</div><% } %>
<% if (user.role === 'admin' && load.review_status === 'flagged_missing_info') { %>
  <div class="reject-note">
    <strong>Flagged — missing info</strong>
    <% if (load.review_set_by_name) { %> by <%= load.review_set_by_name %><% if (load.review_set_at) { %> on <%= auditStamp(load.review_set_at) %><% } %><% } %>
    <div><%= load.review_notes || load.missing_info_note || 'Missing information' %></div>
  </div>
<% } else if (user.role === 'admin' && load.review_status && load.review_status !== 'none') { %>
  <p>
    <span class="status <%= reviewStatusClass(load.review_status) %>"><%= reviewStatusLabel(load.review_status) %></span>
    <% if (load.review_set_by_name) { %><span class="muted">Set by <%= load.review_set_by_name %><% if (load.review_set_at) { %> on <%= auditStamp(load.review_set_at) %><% } %></span><% } %>
  </p>
<% } %>
<% if (user.role === 'admin' && load.review_decision === 'rejected') { %>
  <div class="reject-note">
    <strong>Rejected</strong><% if (load.review_decision_by_name) { %> by <%= load.review_decision_by_name %><% if (load.review_decision_at) { %> on <%= auditStamp(load.review_decision_at) %><% } %><% } %>
    <% if (load.review_decision_reason) { %><div><%= load.review_decision_reason %></div><% } %>
  </div>
<% } else if (user.role === 'admin' && load.review_decision === 'accepted') { %>
  <p class="muted">Accepted by <%= load.review_decision_by_name || 'admin' %><% if (load.review_decision_at) { %> on <%= auditStamp(load.review_decision_at) %><% } %></p>
<% } %>
<% if (user.role === 'admin' && load.status === 'submitted') { %>
  <% const gaps = submittedLoadGaps(load, tickets && tickets.length); %>
  <% if (gaps.length) { %><div class="reject-note"><strong>Submitted load missing:</strong> <%= gaps.join(', ') %></div><% } %>
<% } %>
<% if (load.status === 'draft' && load.rejection_reason) { %>
  <div class="reject-note"><strong>Rejection reason:</strong> <%= load.rejection_reason %></div>
<% } %>
<% if (load.approved_by_name && load.status === 'approved') { %>
  <p class="muted">Approved by <%= load.approved_by_name %><% if (load.approved_at) { %> on <%= auditStamp(load.approved_at) %><% } %></p>
<% } %>
<% if (load.rejected_by_name && load.status === 'draft') { %>
  <p class="muted">Rejected by <%= load.rejected_by_name %><% if (load.rejected_at) { %> on <%= auditStamp(load.rejected_at) %><% } %></p>
<% } %>
<% if (load.updated_by_name) { %>
  <p class="muted">Edited by <%= load.updated_by_name %><% if (load.updated_at) { %> on <%= auditStamp(load.updated_at) %><% } %></p>
<% } %>
<% if (typeof audit !== 'undefined' && audit && audit.length) { %>
  <div class="card">
    <h2>Audit</h2>
    <% audit.forEach(function (entry) { %>
      <div><%= entry.action %> by <%= entry.actor_name %> on <%= auditStamp(entry.created_at) %><% if (entry.detail) { %> — <%= entry.detail %><% } %></div>
    <% }) %>
  </div>
<% } %>

<div class="card">
  <div><strong>Load #</strong> <%= displayLoadNumber(load.load_number) %></div>
  <div><strong>Ticket #</strong> <%= load.ticket_number || '—' %></div>
  <div><strong>Date</strong> <%= formatLoadDate(load.load_date) || '—' %></div>
  <div><strong>Contractor</strong> <%= load.driver_name || 'Unassigned' %></div>
  <div><strong>Project</strong> <%= load.project_display || '—' %></div>
  <div><strong>Trucks</strong> <%= loadTruckLabel(load) || '—' %></div>
  <div><strong>Origin</strong> <%= load.origin || '—' %></div>
  <div><strong>Destination</strong> <%= load.destination || load.description || '—' %></div>
  <div><strong>Qty/Wet Ton</strong> <%= load.weight_quantity != null ? load.weight_quantity : '—' %></div>
  <div><strong>Rate</strong> <%= usd(load.rate) %></div>
  <% if (user.role === 'admin' && load.payInfo) { %>
    <%# Item 2: Driver Pay above the Total Load Pay that will be invoiced, at every status. %>
    <div class="pay-line admin-driver-pay"><strong>Contractor Pay</strong> <%= usd(load.payInfo.pay) %></div>
    <div class="muted"><%= load.payInfo.basis %> · Drive Time <%= usd(load.payInfo.drive) %> · Self Load <%= usd(load.payInfo.self) %> · Detention <%= usd(load.payInfo.detention) %>. <% if (load.payInfo.flat) { %>Drive Time, Self Load, and Detention are added in full.<% } else { %>Drive Time is the contractor's pay percentage of the drive-time fee. Self Load and Detention are added in full.<% } %> Fuel surcharge is not included.</div>
    <div class="total-load-pay-line"><strong>Total Load Pay (invoiced)</strong> <%= usd(loadTotalFor(user, load)) %><% if (hasTotalLoadPay(load)) { %> <span class="muted">(flat Total Load Pay; no fuel surcharge added)</span><% } %></div>
  <% } else { %>
  <div><strong>Load Total</strong> <%= usd(loadTotalFor(user, load)) %></div>
  <% if (load.payInfo && load.showPay) { %>
    <div><strong>Contractor Pay Basis</strong> <%= load.payInfo.basis %></div>
  <% } %>
  <% } %>
  <% if (load.showPay && user.role !== 'admin') { %>
    <div class="pay-line"><strong>Contractor Pay</strong> <%= usd(load.payInfo.pay) %></div>
    <div class="muted"><%= load.payInfo.basis %> · Drive Time <%= usd(load.payInfo.drive) %> · Self Load <%= usd(load.payInfo.self) %> · Detention <%= usd(load.payInfo.detention) %>. <% if (load.payInfo.flat) { %>Drive Time, Self Load, and Detention are added in full.<% } else { %>Drive Time is the contractor's pay percentage of the drive-time fee. Self Load and Detention are added in full.<% } %> Fuel surcharge is not included.</div>
  <% } %>
  <% if (user.role === 'admin') { %>
    <div><strong>Fuel Surcharge</strong> <%= Number(load.has_fuel_surcharge) === 1 ? ((function (f) { return f.pending ? 'Yes (Rate pending — $0.00 until this week\'s fuel rate is posted)' : ('Yes (' + usd(f.total) + ' @ ' + Number(f.percent).toFixed(2) + '%, week rate $' + Number(f.dieselRate).toFixed(3) + ' effective ' + f.effectiveDate + ')'); })(loadFuelSurcharge(load, typeof fuelRates !== 'undefined' ? fuelRates : []))) : 'No' %></div>
  <% } %>
  <div><strong>Drive Time</strong> <%= Number(load.has_drive_time) === 1 ? usd(load.drive_time_amount) : 'No' %></div>
  <div><strong>Self Load</strong> <%= Number(load.has_self_load) === 1 ? usd(load.self_load_amount) : 'No' %></div>
  <div><strong>Detention</strong> <%= Number(load.detention) === 1 ? usd(load.detention_amount) : 'No' %></div>
  <% if (user.role === 'admin') { %>
    <div><strong>Shipper detention</strong> (billed to the customer) <%= Number(load.shipper_detention) === 1 ? usd(load.shipper_detention_amount) : 'No' %></div>
  <% } %>
  <div class="load-notes-view"><strong>Notes</strong> <span class="shared-notes-badge">Visible to Admin &amp; Contractor</span>
    <div class="load-notes-text"><%= load.notes || load.admin_notes || '—' %></div>
  </div>
</div>

<div class="card">
  <h2>Load Ticket/BOL</h2>
  <% if (!tickets.length) { %>
    <p>No ticket or BOL uploaded.</p>
  <% } %>
  <% tickets.forEach(function (ticket) { %>
    <% const kind = ticketFileKind(ticket.original_name || ticket.filename); %>
    <% const fileUrl = '/loads/' + load.id + '/files/' + ticket.id; %>
    <div class="ticket-preview">
      <strong><%= ticket.original_name || 'Ticket' %></strong>
      <div class="ticket-links">
        <a href="<%= fileUrl %>" target="_blank" rel="noopener">View</a>
        <a href="<%= fileUrl %>?download=1">Download</a>
      </div>
      <% if (kind === 'image') { %>
        <img src="<%= fileUrl %>" alt="<%= ticket.original_name || 'Load ticket' %>">
      <% } else if (kind === 'pdf') { %>
        <iframe src="<%= fileUrl %>" title="<%= ticket.original_name || 'Load ticket' %>"></iframe>
      <% } else { %>
        <p class="muted">Open or download this file to review it.</p>
      <% } %>
    </div>
  <% }) %>
</div>

<% const lockedLoad = settlementFinalized(load); %>
<% if (user.role === 'admin' && lockedLoad) { %>
  <div class="card load-locked">
    <h2>Locked</h2>
    <p>This load is Settled: <%= load.driver_name || 'the contractor' %>'s weekly settlement<%= load.load_date ? ' for the ' + settlementWeekLabel(load.load_date) : '' %> is finalized. It can no longer be edited, rejected, or deleted.</p>
  </div>
<% } %>
<% if (user.role === 'admin' && !lockedLoad) { %>
  <div class="card">
    <h2>Edit Load</h2>
    <% if (load.status === 'approved') { %><p class="muted edit-after-approval-note">This load is Approved for Settlement. Only an admin can edit it, and every change is written to the load history. Changes flow to the contractor settlement and the invoice until the week's settlement is finalized.</p><% } %>
    <form method="POST" action="/loads/<%= load.id %>" enctype="multipart/form-data" id="review_edit_form">
      <div class="load-date-ticket-row">
        <div class="field-date-compact">
          <label>Load Date <span class="required-mark" aria-hidden="true">*</span></label>
          <input type="date" name="load_date" class="input-date-compact" max="9999-12-31" required aria-required="true" value="<%= load.load_date || '' %>">
        </div>
        <div class="field-ticket-flex">
          <label>Ticket Number</label>
          <input type="text" name="ticket_number" value="<%= load.ticket_number || '' %>" placeholder="Ticket #">
        </div>
      </div>
      <label>Project</label>
      <select name="project_id" id="review_project_select">
        <option value="">-- Select Project --</option>
        <% (projects || []).forEach(function (project) { %>
          <option value="<%= project.id %>"
            data-rate="<%= project.default_rate %>"
            data-fsc="<%= project.has_fuel_surcharge ? 1 : 0 %>"
            data-drivetime="<%= project.has_drive_time ? 1 : 0 %>"
            data-drivetime-amount="<%= project.default_drive_time_amount %>"
            data-pay-type="<%= project.default_driver_pay_type || 'percentage' %>"
            data-flat-rate="<%= project.default_driver_flat_rate || 0 %>"
            data-total-load-pay="<%= project.default_total_load_pay != null ? project.default_total_load_pay : '' %>"
            <%= String(load.project_id) === String(project.id) ? 'selected' : '' %>><%= project.display_name %></option>
        <% }) %>
      </select>
      <div class="origin-destination-row">
        <div>
          <label for="edit_origin">Origin</label>
          <input type="text" name="origin" id="edit_origin" value="<%= load.origin || '' %>" placeholder="Pickup location">
        </div>
        <div>
          <label for="edit_destination">Destination</label>
          <input type="text" name="destination" id="edit_destination" value="<%= load.destination || load.description || '' %>" placeholder="Delivery location / jobsite destination">
        </div>
      </div>
      <label for="edit_load_notes">Notes <span class="shared-notes-badge">Visible to Admin &amp; Contractor</span></label>
      <textarea name="notes" id="edit_load_notes" class="load-notes-input" rows="2" maxlength="2000" placeholder="Notes for this load (Admin and Contractor can both see these)"><%= load.notes || load.admin_notes || '' %></textarea>
      <% if (trucks && trucks.length) { %>
        <label>Truck</label>
        <select name="truck_id">
          <option value="">-- No truck --</option>
          <% trucks.forEach(function (truck) { %>
            <option value="<%= truck.id %>" <%= String(load.truck_id) === String(truck.id) ? 'selected' : '' %>><%= loadTruckLabel(truck) %></option>
          <% }) %>
        </select>
      <% } %>
      <div class="load-rate-qty-drive-row">
        <div class="field-num-compact">
          <label for="review_rate">Load Rate ($)</label>
          <input data-money="1" type="number" step="0.01" min="0" max="9999.99" inputmode="decimal" placeholder="0000.00" name="rate" id="review_rate" class="input-num-4dec" data-four-dec="1" value="<%= load.rate != null && load.rate !== '' ? Number(load.rate).toFixed(2) : '' %>">
        </div>
        <div class="field-num-compact">
          <label for="review_qty">Wet Ton/Qty</label>
          <input type="number" step="0.01" min="0" max="9999.99" inputmode="decimal" placeholder="0000.00" name="weight_quantity" id="review_qty" class="input-num-4dec" data-four-dec="1" value="<%= load.weight_quantity != null ? load.weight_quantity : '' %>">
        </div>
      </div>
      <div class="load-self-row">
        <div class="self-load-group">
          <label class="self-check-label" for="has_self_load">
            <input type="checkbox" name="has_self_load" id="has_self_load" value="1" <%= load.has_self_load ? 'checked' : '' %>>
            <span>Self Load ($)</span>
          </label>
        </div>
        <div class="self-load-group">
          <label class="self-check-label" for="review_detention">
            <input type="checkbox" name="detention" id="review_detention" value="1" <%= load.detention ? 'checked' : '' %>>
            <span>Detention</span>
          </label>
        </div>
        <div class="self-load-group fuel-surcharge-group">
          <label class="self-check-label" for="has_fuel_surcharge">
            <input type="checkbox" name="has_fuel_surcharge" id="has_fuel_surcharge" value="1" data-fsc-rates="<%= JSON.stringify(typeof fuelRates !== 'undefined' ? fuelRates : []) %>" <%= load.has_fuel_surcharge ? 'checked' : '' %>>
            <span>Fuel Surcharge</span>
          </label>
          <input type="hidden" name="fuel_surcharge_amount" id="review_fuel_amount" value="<%= Number(load.has_fuel_surcharge) ? money(loadFuelSurcharge(load, typeof fuelRates !== 'undefined' ? fuelRates : []).total) : '0.00' %>">
        </div>
      </div>
      <div class="addon-amount-row">
        <div id="review_self_wrap" class="addon-amount" style="<%= load.has_self_load ? '' : 'display:none;' %>">
          <label for="review_self_amount">Self Load $</label>
          <input data-money="1" type="number" step="0.01" min="0" max="9999.99" inputmode="decimal" placeholder="20.00" name="self_load_amount" id="review_self_amount" data-four-dec="1" value="<%= load.self_load_amount != null && Number(load.self_load_amount) > 0 ? Number(load.self_load_amount).toFixed(2) : '20.00' %>">
        </div>
        <div id="review_detention_wrap" class="addon-amount" style="<%= load.detention ? '' : 'display:none;' %>">
          <label for="review_detention_amount">Detention $</label>
          <input data-money="1" type="number" step="0.01" min="0" inputmode="decimal" placeholder="0.00" name="detention_amount" id="review_detention_amount" value="<%= load.detention && load.detention_amount != null && load.detention_amount !== '' ? Number(load.detention_amount).toFixed(2) : '' %>">
        </div>
      </div>
      <div class="load-self-row">
        <div class="self-load-group drive-time-group">
          <label class="self-check-label" for="has_drive_time">
            <input type="checkbox" name="has_drive_time" id="has_drive_time" value="1" <%= load.has_drive_time ? 'checked' : '' %>>
            <span>Drive Time ($)</span>
          </label>
        </div>
        <div id="review_drive_wrap" class="addon-amount" style="<%= load.has_drive_time ? '' : 'display:none;' %>">
          <label for="review_drive_amount">Drive Time $</label>
          <input data-money="1" type="number" step="0.01" min="0" max="9999.99" inputmode="decimal" placeholder="0000.00" name="drive_time_amount" id="review_drive_amount" data-four-dec="1" value="<%= load.has_drive_time && load.drive_time_amount != null ? Number(load.drive_time_amount).toFixed(2) : '0.00' %>">
        </div>
      </div>
      <div class="load-self-row">
        <div class="self-load-group">
          <label class="self-check-label" for="review_shipper_detention">
            <input type="checkbox" name="shipper_detention" id="review_shipper_detention" value="1" <%= load.shipper_detention ? 'checked' : '' %>>
            <span>Bill shipper for detention</span>
          </label>
        </div>
        <p class="muted" style="margin:0;">Billed to the customer. Separate from the contractor Detention checkbox above.</p>
      </div>
      <div class="addon-amount-row">
        <div id="review_shipper_detention_wrap" class="addon-amount" style="<%= load.shipper_detention ? '' : 'display:none;' %>">
          <label for="review_shipper_detention_amount">Shipper detention $ (billed to customer)</label>
          <input data-money="1" type="number" step="0.01" min="0" inputmode="decimal" placeholder="0.00" name="shipper_detention_amount" id="review_shipper_detention_amount" value="<%= load.shipper_detention && load.shipper_detention_amount != null && load.shipper_detention_amount !== '' ? Number(load.shipper_detention_amount).toFixed(2) : '' %>">
        </div>
      </div>
      <div class="load-totals-row">
        <div class="load-total-under driver-pay-under" id="review_driver_pay"><%= load.payInfo ? 'Contractor Pay: ' + usd(load.payInfo.pay) : 'Contractor Pay: $0.00' %></div>
        <div class="load-total-under" id="review_load_total">Total Load Pay (invoiced): <%= usd(loadTotalAmount(load)) %></div>
        <div class="load-total-under fuel-total-under" id="review_fuel_total" title="Uses the fuel rate for the Load Date's week: Load Rate × FSC % × Wet Tons"><% const fscNow = loadFuelSurcharge(load, typeof fuelRates !== 'undefined' ? fuelRates : []); %><%= !Number(load.has_fuel_surcharge) ? 'Fuel Surcharge Total: $0.00' : (fscNow.pending ? 'Fuel Surcharge Total: Rate pending ($0.00)' : 'Fuel Surcharge Total: ' + usd(fscNow.total) + ' @ ' + Number(fscNow.percent).toFixed(2) + '%') %></div>
      </div>
      <label for="driver_pay_type">Contractor Pay Basis / Type</label>
      <select name="driver_pay_type" id="driver_pay_type">
        <option value="percentage" <%= load.driver_pay_type === 'flat' ? '' : 'selected' %>>Percentage of Load (% — uses Contractor's Profile Pay %)</option>
        <option value="flat" <%= load.driver_pay_type === 'flat' ? 'selected' : '' %>>Flat / Daily Rate ($ for this load/day)</option>
      </select>
      <div id="flat_rate_wrap">
        <label for="driver_flat_rate">Contractor Flat / Daily Rate ($)</label>
        <input data-money="1" type="number" step="0.01" min="0" max="9999.99" inputmode="decimal" name="driver_flat_rate" id="driver_flat_rate" class="input-num-4dec" value="<%= load.driver_flat_rate != null && load.driver_flat_rate !== '' ? Number(load.driver_flat_rate).toFixed(2) : '0.00' %>">
      </div>
      <p class="muted" id="pay_basis_help"></p>
      <div id="total_load_pay_wrap" class="total-load-pay-field">
        <label for="total_load_pay">Total Load Pay ($) <span class="muted">what the customer pays DT1</span></label>
        <input data-money="1" type="number" step="0.01" min="0" inputmode="decimal" name="total_load_pay" id="total_load_pay" placeholder="Blank = Qty × Rate" value="<%= hasTotalLoadPay(load) ? Number(load.total_load_pay).toFixed(2) : '' %>">
        <p class="muted">Filled from the project. When set, this flat amount is what gets invoiced for the load (plus Drive Time and Self Load when checked) and no fuel surcharge is added. Leave blank to invoice Qty × Rate as before. Contractors never see this amount.</p>
      </div>
      <% if (drivers && drivers.length) { %>
        <label>Assign Contractor</label>
        <select name="driver_id">
          <option value="">-- Select Contractor --</option>
          <% drivers.forEach(function (driver) { %>
            <option value="<%= driver.id %>" data-pay-pct="<%= driver.pay_percentage != null ? driver.pay_percentage : '' %>" <%= String(load.driver_id) === String(driver.id) ? 'selected' : '' %>><%= driver.name %><%= driver.status === 'inactive' ? ' (Inactive)' : '' %></option>
          <% }) %>
        </select>
      <% } %>
      <% if (tickets.length && load.status !== 'approved') { %>
        <label>Remove uploaded ticket/BOL</label>
        <% tickets.forEach(function (ticket) { %>
          <div class="check">
            <input type="checkbox" name="remove_tickets" value="<%= ticket.id %>" id="remove-<%= ticket.id %>">
            <label for="remove-<%= ticket.id %>">Remove <%= ticket.original_name || 'file' %></label>
          </div>
        <% }) %>
      <% } %>
      <label>Add ticket/BOL files</label>
      <input type="file" name="tickets" accept="image/*,application/pdf,.pdf,.doc,.docx,.xls,.xlsx" multiple>
      <button type="submit" name="action" value="save">Save Changes</button>
    </form>
  </div>
<% } %>
<% if (user.role === 'admin') { %>

  <form class="card" method="POST" action="/loads/<%= load.id %>/review">
    <h2>Logan review</h2>
    <p class="muted">Logan flags a load when information is missing. An admin can edit the notes or clear the flag. Contractors do not see this.</p>
    <p>
      <span class="status <%= reviewStatusClass(load.review_status) %>"><%= reviewStatusLabel(load.review_status) %></span>
      <% if (load.review_set_by_name) { %>
        <span class="muted">Set by <%= load.review_set_by_name %><% if (load.review_set_at) { %> on <%= auditStamp(load.review_set_at) %><% } %></span>
      <% } %>
    </p>
    <label for="review_notes">Review notes</label>
    <textarea name="review_notes" id="review_notes" rows="4" placeholder="One missing item per line"><%= load.review_notes || '' %></textarea>
    <button type="submit" name="review_action" value="save">Save notes</button>
    <button type="submit" class="btn-draft" name="review_action" value="clear">Clear flag</button>
  </form>

  <form class="card" method="POST" action="/loads/<%= load.id %>/review-decision">
    <h2>Accept or reject</h2>
    <p class="muted">Only an admin can accept or reject a load. Logan can flag a load and cannot make this decision. Rejecting a Submitted or Approved load sends it back to the contractor as Draft, and the contractor sees the reason.</p>
    <% if (load.review_decision === 'rejected') { %>
      <p>Current decision: <strong>Rejected</strong><% if (load.review_decision_by_name) { %> by <%= load.review_decision_by_name %><% if (load.review_decision_at) { %> on <%= auditStamp(load.review_decision_at) %><% } %><% } %></p>
    <% } else if (load.review_decision === 'accepted') { %>
      <p>Current decision: <strong>Accepted</strong><% if (load.review_decision_by_name) { %> by <%= load.review_decision_by_name %><% if (load.review_decision_at) { %> on <%= auditStamp(load.review_decision_at) %><% } %><% } %></p>
    <% } %>
    <label for="review_decision_reason">Reason (required to reject)</label>
    <textarea name="reason" id="review_decision_reason" rows="3" placeholder="Why this load is rejected / what the contractor should fix"><%= load.review_decision === 'rejected' ? (load.review_decision_reason || load.rejection_reason || '') : '' %></textarea>
    <button class="approve" type="submit" name="decision" value="accepted">Accept load</button>
    <% if (lockedLoad) { %>
      <p class="muted">Reject is not available: the weekly settlement is finalized and the load is locked.</p>
    <% } else { %>
    <button class="danger" type="submit" name="decision" value="rejected" onclick="return (function (form) { var reason = (form.reason && form.reason.value || '').trim(); if (!reason) { alert('A rejection reason is required.'); if (form.reason) form.reason.focus(); return false; } return confirm('Reject this load<%= (load.status === 'submitted' || load.status === 'approved') ? ' and send it back to the contractor as Draft' : '' %>?'); })(this.form);">Reject load</button>
    <% } %>
  </form>

  <div class="review-actions">
    <% if (canApproveForSettlement(load)) { %>
      <form method="POST" action="/loads/<%= load.id %>/approve">
        <button class="approve" type="submit">Approve for Settlement</button>
      </form>
    <% } %>
    <% if (loadDeletable(load)) { %>
      <form method="POST" action="/loads/<%= load.id %>/delete" onsubmit="return confirm('Are you sure? This cannot be undone.\n\nDelete Load permanently erases load <%= load.load_number ? String(load.load_number).replace(/[\\'\r\n]/g, '') : ('#' + load.id) %><%= load.ticket_number ? ' (ticket ' + String(load.ticket_number).replace(/[\\'\r\n]/g, '') + ')' : '' %> and its ticket files. Use it for duplicates.');">
        <button class="danger" type="submit">Delete Load</button>
      </form>
    <% } else { %>
      <p class="muted">Delete Load is not available after a load is Approved for Settlement.</p>
    <% } %>
  </div>
<% } else if (loadEditableBy(user, load)) { %>
  <p><a class="btn" href="/loads/<%= load.id %>/edit"><%= load.status === 'draft' ? 'Edit Draft' : 'Edit Load' %></a></p>
  <% if (load.status === 'submitted') { %><p class="muted">You can edit this load until the admin approves it for settlement.</p><% } %>
<% } %>
<p><a href="/loads">Back to Loads</a></p>
<script src="/js/fuel-surcharge.js"></script>
<script src="/js/load-pay.js"></script>
<script>
  const payType = document.getElementById('driver_pay_type');
  const flatWrap = document.getElementById('flat_rate_wrap');
  const payHelp = document.getElementById('pay_basis_help');
  const reviewRate = document.getElementById('review_rate');
  const reviewQty = document.getElementById('review_qty');
  const reviewDriveCheck = document.getElementById('has_drive_time');
  const reviewDriveWrap = document.getElementById('review_drive_wrap');
  const reviewDriveAmount = document.getElementById('review_drive_amount');
  const reviewSelfCheck = document.getElementById('has_self_load');
  const reviewSelfWrap = document.getElementById('review_self_wrap');
  const reviewSelfAmount = document.getElementById('review_self_amount');
  const reviewFlatRate = document.getElementById('driver_flat_rate');
  const reviewLoadTotal = document.getElementById('review_load_total');
  const reviewFuelCheck = document.getElementById('has_fuel_surcharge');
  const reviewFuelAmount = document.getElementById('review_fuel_amount');
  const reviewFuelTotal = document.getElementById('review_fuel_total');
  const fscRates = reviewFuelCheck ? (function () { try { return JSON.parse(reviewFuelCheck.getAttribute('data-fsc-rates') || '[]'); } catch (e) { return []; } })() : [];
  const fscDateInput = document.querySelector('input[name="load_date"]');
  const reviewProjectSelect = document.getElementById('review_project_select');

  function reviewTotalLoadPayValue() {
    const el = document.getElementById('total_load_pay');
    const raw = el ? String(el.value || '').trim() : '';
    if (raw === '' || !Number.isFinite(Number(raw))) return null;
    return Number(raw);
  }

  function syncReviewFuelAmount() {
    if (!reviewFuelCheck) return;
    if (reviewTotalLoadPayValue() !== null) {
      if (reviewFuelAmount) reviewFuelAmount.value = '0.00';
      if (reviewFuelTotal) reviewFuelTotal.textContent = 'Fuel Surcharge: not added (Total Load Pay is set)';
      return;
    }
    if (!reviewFuelCheck.checked) {
      if (reviewFuelAmount) reviewFuelAmount.value = '0.00';
      if (reviewFuelTotal) reviewFuelTotal.textContent = 'Fuel Surcharge Total: $0.00';
      return;
    }
    const qty = Number(reviewQty && reviewQty.value);
    const rate = Number(reviewRate && reviewRate.value);
    const isFlat = payType && payType.value === 'flat';
    // Surcharge/Ton = Load Rate x FSC decimal; Total = Surcharge/Ton x Wet Tons (flat loads: Flat Amount x FSC decimal)
    const fsc = window.DT1Fuel.loadFuelSurchargeForDate({
      history: fscRates,
      loadDate: fscDateInput ? fscDateInput.value : '',
      rate: Number.isFinite(rate) ? rate : 0,
      tons: Number.isFinite(qty) ? qty : 0,
      isFlat,
      flatAmount: Number(reviewFlatRate && reviewFlatRate.value) || 0
    });
    const calc = fsc.total.toFixed(2);
    if (reviewFuelAmount) reviewFuelAmount.value = calc;
    if (reviewFuelTotal) {
      reviewFuelTotal.textContent = fsc.pending
        ? 'Fuel Surcharge Total: Rate pending ($0.00)'
        : 'Fuel Surcharge Total: ' + window.DT1LoadPay.usd(fsc.total) + ' @ ' + fsc.percent.toFixed(2) + '%';
      reviewFuelTotal.title = fsc.pending
        ? 'No fuel rate posted yet for this Load Date\'s week; $0.00 until it is posted.'
        : 'Week rate $' + fsc.dieselRate.toFixed(3) + ' effective ' + fsc.effectiveDate + ': Load Rate × ' + fsc.decimal + ' × Wet Tons';
    }
    return;
  }

  function syncReviewLoadTotal() {
    if (!reviewLoadTotal) return;
    const qty = Number(reviewQty && reviewQty.value);
    const rate = Number(reviewRate && reviewRate.value);
    const isFlat = payType && payType.value === 'flat';
    const baseHaul = (Number.isFinite(qty) ? qty : 0) * (Number.isFinite(rate) ? rate : 0);
    const base = (isFlat && baseHaul === 0)
      ? (Number.isFinite(Number(reviewFlatRate && reviewFlatRate.value)) ? Number(reviewFlatRate.value) : 0)
      : baseHaul;
    const drive = (reviewDriveCheck && reviewDriveCheck.checked)
      ? (Number.isFinite(Number(reviewDriveAmount && reviewDriveAmount.value)) ? Number(reviewDriveAmount.value) : 0)
      : 0;
    const self = (reviewSelfCheck && reviewSelfCheck.checked)
      ? (Number.isFinite(Number(reviewSelfAmount && reviewSelfAmount.value)) ? Number(reviewSelfAmount.value) : 0)
      : 0;
    const totalLoadPay = reviewTotalLoadPayValue();
    reviewLoadTotal.textContent = 'Total Load Pay (invoiced): ' + window.DT1LoadPay.usd((totalLoadPay !== null ? totalLoadPay : base) + drive + self);
    const reviewDriverPay = document.getElementById('review_driver_pay');
    if (reviewDriverPay) {
      const driverSel = document.querySelector('#review_edit_form select[name="driver_id"]');
      const driverOpt = driverSel && driverSel.options ? driverSel.options[driverSel.selectedIndex] : null;
      const pct = Number(driverOpt && driverOpt.getAttribute('data-pay-pct')) || 0;
      const detBox = document.getElementById('review_detention');
      const detAmt = document.getElementById('review_detention_amount');
      const detention = detBox && detBox.checked ? (Number(detAmt && detAmt.value) || 0) : 0;
      const pay = window.DT1LoadPay.driverPay({
        qty, rate, isFlat, flatRate: Number(reviewFlatRate && reviewFlatRate.value) || 0, drive, self, detention, pct
      });
      reviewDriverPay.textContent = 'Contractor Pay: ' + window.DT1LoadPay.usd(pay);
    }
    syncReviewFuelAmount();
  }

  function syncReviewDriveWrap() {
    if (reviewDriveWrap && reviewDriveCheck) {
      reviewDriveWrap.style.display = reviewDriveCheck.checked ? 'block' : 'none';
    }
  }

  function syncReviewSelfWrap() {
    if (reviewSelfWrap && reviewSelfCheck) {
      if (reviewSelfCheck.checked && reviewSelfAmount && (!reviewSelfAmount.value || Number(reviewSelfAmount.value) === 0)) {
        reviewSelfAmount.value = '20.00';
      }
      reviewSelfWrap.style.display = reviewSelfCheck.checked ? 'block' : 'none';
    }
  }

  if (reviewDriveCheck) {
    reviewDriveCheck.addEventListener('change', () => {
      if (reviewDriveCheck.checked) {
        const opt = reviewProjectSelect && reviewProjectSelect.options ? reviewProjectSelect.options[reviewProjectSelect.selectedIndex] : null;
        if (reviewDriveAmount && (!reviewDriveAmount.value || Number(reviewDriveAmount.value) === 0)) {
          reviewDriveAmount.value = (Number(opt ? opt.getAttribute('data-drivetime-amount') : 0) || 0).toFixed(2);
        }
      } else if (reviewDriveAmount) {
        reviewDriveAmount.value = '0.00';
      }
      syncReviewDriveWrap();
      syncReviewLoadTotal();
    });
  }
  if (reviewDriveAmount && reviewDriveCheck) {
    reviewDriveAmount.addEventListener('input', () => {
      if (Number(reviewDriveAmount.value) > 0 && !reviewDriveCheck.checked) {
        reviewDriveCheck.checked = true;
      }
    });
  }
  if (fscDateInput) {
    fscDateInput.addEventListener('change', syncReviewFuelAmount);
    fscDateInput.addEventListener('input', syncReviewFuelAmount);
  }
  if (reviewFuelCheck) {
    reviewFuelCheck.addEventListener('change', () => {
      syncReviewFuelAmount();
      syncReviewLoadTotal();
    });
  }
  if (reviewProjectSelect) {
    reviewProjectSelect.addEventListener('change', () => {
      const opt = reviewProjectSelect.options[reviewProjectSelect.selectedIndex];
      if (!opt || !opt.value) return;
      if (reviewRate) reviewRate.value = (Number(opt.getAttribute('data-rate')) || 0).toFixed(2);
      if (reviewFuelCheck) reviewFuelCheck.checked = opt.getAttribute('data-fsc') === '1';
      const hasDrive = opt.getAttribute('data-drivetime') === '1';
      if (reviewDriveCheck) reviewDriveCheck.checked = hasDrive;
      if (reviewDriveAmount) reviewDriveAmount.value = hasDrive ? (Number(opt.getAttribute('data-drivetime-amount')) || 0).toFixed(2) : '0.00';
      const totalLoadPayInput = document.getElementById('total_load_pay');
      if (totalLoadPayInput) {
        const projectTotal = String(opt.getAttribute('data-total-load-pay') || '').trim();
        totalLoadPayInput.value = projectTotal === '' ? '' : (Number(projectTotal) || 0).toFixed(2);
      }
      syncReviewDriveWrap();
      syncReviewLoadTotal();
    });
  }
  if (reviewSelfCheck) {
    reviewSelfCheck.addEventListener('change', () => {
      if (reviewSelfCheck.checked) {
        if (reviewSelfAmount && (!reviewSelfAmount.value || Number(reviewSelfAmount.value) === 0)) {
          reviewSelfAmount.value = '20.00';
        }
      } else if (reviewSelfAmount) {
        reviewSelfAmount.value = '0.00';
      }
      syncReviewSelfWrap();
      syncReviewLoadTotal();
    });
  }
  [reviewRate, reviewQty, reviewDriveAmount, reviewSelfAmount, reviewFlatRate, document.getElementById('total_load_pay'),
    document.getElementById('review_detention'), document.getElementById('review_detention_amount'),
    document.querySelector('#review_edit_form select[name="driver_id"]')].forEach((el) => {
    if (el) {
      el.addEventListener('input', syncReviewLoadTotal);
      el.addEventListener('change', syncReviewLoadTotal);
    }
  });

  function syncPayType() {
    if (!payType || !flatWrap) return;
    const flat = payType.value === 'flat';
    flatWrap.style.display = flat ? 'block' : 'none';
    if (payHelp) {
      payHelp.textContent = flat
        ? 'Contractor Pay = Contractor Flat / Daily Rate + Drive Time + Self Load + Detention. Drive Time, Self Load, and Detention are added in full. Fuel surcharge is not included.'
        : 'Contractor Pay = (Qty/Wet Ton × Rate × Contractor Pay %) + (Drive Time × Contractor Pay %) + Self Load + Detention. Self Load and Detention are added in full. Fuel surcharge is not included.';
    }
    syncReviewLoadTotal();
  }
  if (payType) {
    payType.addEventListener('change', syncPayType);
    syncPayType();
  }
  syncReviewDriveWrap();
  syncReviewSelfWrap();
  syncReviewLoadTotal();

  const reviewDetention = document.getElementById('review_detention');
  const reviewDetentionAmount = document.getElementById('review_detention_amount');
  const reviewDetentionWrap = document.getElementById('review_detention_wrap');
  function syncReviewDetention() {
    if (!reviewDetention || !reviewDetentionWrap) return;
    const on = reviewDetention.checked;
    reviewDetentionWrap.style.display = on ? 'block' : 'none';
    if (!on && reviewDetentionAmount) reviewDetentionAmount.value = '';
  }
  if (reviewDetention) reviewDetention.addEventListener('change', syncReviewDetention);
  if (reviewDetentionAmount) {
    reviewDetentionAmount.addEventListener('input', () => {
      const raw = String(reviewDetentionAmount.value || '');
      const dot = raw.indexOf('.');
      if (dot >= 0 && raw.length - dot - 1 > 2) reviewDetentionAmount.value = raw.slice(0, dot + 3);
    });
  }
  syncReviewDetention();

  <% if (user.role === 'admin') { %>
  const reviewShipperDetention = document.getElementById('review_shipper_detention');
  const reviewShipperDetentionAmount = document.getElementById('review_shipper_detention_amount');
  const reviewShipperDetentionWrap = document.getElementById('review_shipper_detention_wrap');
  function syncReviewShipperDetention() {
    if (!reviewShipperDetention || !reviewShipperDetentionWrap) return;
    const on = reviewShipperDetention.checked;
    reviewShipperDetentionWrap.style.display = on ? 'block' : 'none';
    if (!on && reviewShipperDetentionAmount) reviewShipperDetentionAmount.value = '';
  }
  if (reviewShipperDetention) reviewShipperDetention.addEventListener('change', syncReviewShipperDetention);
  if (reviewShipperDetentionAmount) {
    reviewShipperDetentionAmount.addEventListener('input', () => {
      const raw = String(reviewShipperDetentionAmount.value || '');
      const dot = raw.indexOf('.');
      if (dot >= 0 && raw.length - dot - 1 > 2) reviewShipperDetentionAmount.value = raw.slice(0, dot + 3);
    });
  }
  syncReviewShipperDetention();
  <% } %>
</script>
<%- include('partials/close') %>
