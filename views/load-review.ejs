<%- include('partials/open', { title: 'Review Load', user: user, active: 'loads', headerTitle: 'Review Load', backHref: '/loads' }) %>
<h1>Review Load</h1>
<p>
  <span class="status <%= load.status %>"><%= loadStatusLabel(load.status, load.settlement_status) %></span>
  <% const origin = loadOriginLabel(load); %>
  <% if (origin) { %><span class="origin-badge"><%= origin %></span><% } %>
  <% if (load.status === 'approved' && load.settlement_status !== 'approved') { %>
    <span class="muted">Pending Driver Settlement Approval<%= load.load_date ? ' · ' + settlementWeekLabel(load.load_date) : '' %></span>
  <% } else if (load.settlement_status === 'approved') { %>
    <span class="muted">Included in the approved driver settlement<%= load.load_date ? ' · ' + settlementWeekLabel(load.load_date) : '' %></span>
  <% } %>
</p>
<% if (saved === 'assigned') { %>
  <div class="all-clear">Load assigned to <%= load.driver_name || 'driver' %> and saved to their Drafts. Text message notification triggered: &ldquo;DT1 Logistics has assigned you a new Load&rdquo;.</div>
<% } %>
<% if (typeof assignedLoadNotice !== 'undefined' && assignedLoadNotice) { %>
  <div class="card assigned-sms-card" id="assigned-sms-card">
    <h2>📲 Driver Load Assignment Text Message Notification</h2>
    <p><strong>Driver:</strong> <%= assignedLoadNotice.driverName || load.driver_name || 'Unassigned' %> (<%= assignedLoadNotice.driverPhone || 'No phone on file' %><% if (assignedLoadNotice.driverEmail) { %> · <%= assignedLoadNotice.driverEmail %><% } %>)</p>
    <p>
      <strong>Text (SMS) Status:</strong>
      <span class="badge <%= (assignedLoadNotice.smsStatus === 'Sent' || String(assignedLoadNotice.smsStatus).indexOf('Sent via') === 0) ? 'green' : 'yellow' %>"><%= assignedLoadNotice.smsStatus %></span>
      <% if (assignedLoadNotice.emailStatus && assignedLoadNotice.emailStatus !== 'Not selected') { %>
        &nbsp;·&nbsp; <strong>Email Status:</strong>
        <span class="badge <%= assignedLoadNotice.emailStatus === 'Sent' ? 'green' : 'yellow' %>"><%= assignedLoadNotice.emailStatus %></span>
      <% } %>
    </p>
    <pre class="sms-preview" id="assigned-sms-text"><%= assignedLoadNotice.smsText %></pre>
    <div class="welcome-actions">
      <% if (assignedLoadNotice.smsHref) { %>
        <a class="btn" href="<%= assignedLoadNotice.smsHref %>">Open Text Message (SMS)</a>
      <% } %>
      <% if (assignedLoadNotice.mailto) { %>
        <a class="btn btn-secondary" href="<%= assignedLoadNotice.mailto %>">Open Email</a>
      <% } %>
      <a class="btn btn-secondary" href="/communications">View in Communications Log</a>
    </div>
  </div>
<% } %>
<% if (saved === 'approved') { %><div class="all-clear">Load approved. It is pending driver settlement approval<%= load.load_date ? ' for the ' + settlementWeekLabel(load.load_date) : '' %>.</div><% } %>
<% if (saved === 'rejected') { %><div class="reject-note">Load sent back to the driver as a draft.</div><% } %>
<% if (saved === 'edited') { %><div class="all-clear">Load saved.</div><% } %>
<% if (saved === 'flag') { %><div class="all-clear">Missing info flag saved.</div><% } %>
<% if (user.role === 'admin' && load.status === 'submitted') { %>
  <% const gaps = submittedLoadGaps(load, tickets && tickets.length); %>
  <% if (gaps.length) { %><div class="reject-note"><strong>Submitted load missing:</strong> <%= gaps.join(', ') %></div><% } %>
<% } %>
<% if (load.missing_info_note) { %>
  <div class="reject-note"><strong>Missing Info Flag:</strong> <%= load.missing_info_note %></div>
<% } %>
<% if (load.status === 'draft' && load.rejection_reason) { %>
  <div class="reject-note"><strong>Rejection reason:</strong> <%= load.rejection_reason %></div>
<% } %>
<% if (load.approved_by_name && load.status === 'approved') { %>
  <p class="muted">Approved by <%= load.approved_by_name %><% if (load.approved_at) { %> on <%= auditStamp(load.approved_at) %><% } %></p>
<% } %>
<% if (load.rejected_by_name && load.status === 'draft') { %>
  <p class="muted">Rejected by <%= load.rejected_by_name %><% if (load.rejected_at) { %> on <%= auditStamp(load.rejected_at) %><% } %></p>
<% } %>
<% if (load.updated_by_name) { %>
  <p class="muted">Edited by <%= load.updated_by_name %><% if (load.updated_at) { %> on <%= auditStamp(load.updated_at) %><% } %></p>
<% } %>
<% if (typeof audit !== 'undefined' && audit && audit.length) { %>
  <div class="card">
    <h2>Audit</h2>
    <% audit.forEach(function (entry) { %>
      <div><%= entry.action %> by <%= entry.actor_name %> on <%= auditStamp(entry.created_at) %><% if (entry.detail) { %> — <%= entry.detail %><% } %></div>
    <% }) %>
  </div>
<% } %>

<div class="card">
  <div><strong>Ticket #</strong> <%= load.ticket_number || '—' %></div>
  <div><strong>Date</strong> <%= load.load_date || '—' %></div>
  <div><strong>Driver</strong> <%= load.driver_name || 'Unassigned' %></div>
  <div><strong>Project</strong> <%= load.project_display || '—' %></div>
  <div><strong>Destination</strong> <%= load.destination || load.description || '—' %></div>
  <div><strong>Qty/Wet Ton</strong> <%= load.weight_quantity != null ? load.weight_quantity : '—' %></div>
  <div><strong>Rate</strong> $<%= money(load.rate) %></div>
  <div><strong>Load Total</strong> $<%= money(loadTotalAmount(load)) %></div>
  <% if (load.payInfo && (user.role === 'admin' || load.showPay)) { %>
    <div><strong>Driver Pay Basis</strong> <%= load.payInfo.basis %></div>
  <% } %>
  <% if (load.showPay) { %>
    <div class="pay-line"><strong>Driver Pay</strong> $<%= money(load.payInfo.pay) %></div>
    <div class="muted"><%= load.payInfo.basis %> · Drive Time $<%= money(load.payInfo.drive) %> · Self Load $<%= money(load.payInfo.self) %>. Fuel surcharge is not included.</div>
  <% } %>
  <% if (user.role === 'admin') { %>
    <div><strong>Fuel Surcharge</strong> <%= Number(load.has_fuel_surcharge) === 1 ? ((function (f) { return f.pending ? 'Yes (Rate pending — $0.00 until this week\'s fuel rate is posted)' : ('Yes ($' + money(f.total) + ' @ ' + Number(f.percent).toFixed(2) + '%, week rate $' + Number(f.dieselRate).toFixed(3) + ' effective ' + f.effectiveDate + ')'); })(loadFuelSurcharge(load, typeof fuelRates !== 'undefined' ? fuelRates : []))) : 'No' %></div>
  <% } %>
  <div><strong>Drive Time</strong> <%= Number(load.has_drive_time) === 1 ? '$' + money(load.drive_time_amount) : 'No' %></div>
  <div><strong>Self Load</strong> <%= Number(load.has_self_load) === 1 ? '$' + money(load.self_load_amount) : 'No' %></div>
  <% if (user.role === 'admin') { %>
    <div><strong>Notes <span class="admin-only-badge">Admin Only</span></strong> <%= load.admin_notes || load.notes || '—' %></div>
  <% } %>
</div>

<div class="card">
  <h2>Load Ticket/BOL</h2>
  <% if (!tickets.length) { %>
    <p>No ticket or BOL uploaded.</p>
  <% } %>
  <% tickets.forEach(function (ticket) { %>
    <% const kind = ticketFileKind(ticket.original_name || ticket.filename); %>
    <% const fileUrl = '/loads/' + load.id + '/files/' + ticket.id; %>
    <div class="ticket-preview">
      <strong><%= ticket.original_name || 'Ticket' %></strong>
      <div class="ticket-links">
        <a href="<%= fileUrl %>" target="_blank" rel="noopener">View</a>
        <a href="<%= fileUrl %>?download=1">Download</a>
      </div>
      <% if (kind === 'image') { %>
        <img src="<%= fileUrl %>" alt="<%= ticket.original_name || 'Load ticket' %>">
      <% } else if (kind === 'pdf') { %>
        <iframe src="<%= fileUrl %>" title="<%= ticket.original_name || 'Load ticket' %>"></iframe>
      <% } else { %>
        <p class="muted">Open or download this file to review it.</p>
      <% } %>
    </div>
  <% }) %>
</div>

<% if (user.role === 'admin') { %>
  <div class="card">
    <h2>Edit Load</h2>
    <form method="POST" action="/loads/<%= load.id %>" enctype="multipart/form-data">
      <div class="load-date-ticket-row">
        <div class="field-date-compact">
          <label>Load Date</label>
          <input type="date" name="load_date" class="input-date-compact" max="9999-12-31" value="<%= load.load_date || '' %>">
        </div>
        <div class="field-ticket-flex">
          <label>Ticket Number</label>
          <input type="text" name="ticket_number" value="<%= load.ticket_number || '' %>" placeholder="Ticket #">
        </div>
      </div>
      <label>Project</label>
      <select name="project_id" id="review_project_select">
        <option value="">-- Select Project --</option>
        <% (projects || []).forEach(function (project) { %>
          <option value="<%= project.id %>"
            data-rate="<%= project.default_rate %>"
            data-fsc="<%= project.has_fuel_surcharge ? 1 : 0 %>"
            data-drivetime="<%= project.has_drive_time ? 1 : 0 %>"
            data-drivetime-amount="<%= project.default_drive_time_amount %>"
            data-pay-type="<%= project.default_driver_pay_type || 'percentage' %>"
            data-flat-rate="<%= project.default_driver_flat_rate || 0 %>"
            <%= String(load.project_id) === String(project.id) ? 'selected' : '' %>><%= project.display_name %></option>
        <% }) %>
      </select>
      <label for="edit_destination">Destination</label>
      <input type="text" name="destination" id="edit_destination" value="<%= load.destination || load.description || '' %>" placeholder="Delivery location / jobsite destination">
      <label for="edit_admin_notes">Notes <span class="admin-only-badge">Admin Only — Not visible to driver</span></label>
      <textarea name="admin_notes" id="edit_admin_notes" rows="3" placeholder="Internal admin notes for this load (visible to Admin only)"><%= load.admin_notes || load.notes || '' %></textarea>
      <% if (trucks && trucks.length) { %>
        <label>Truck</label>
        <select name="truck_id">
          <option value="">-- No truck --</option>
          <% trucks.forEach(function (truck) { %>
            <option value="<%= truck.id %>" <%= String(load.truck_id) === String(truck.id) ? 'selected' : '' %>><%= truck.number %><%= truck.description ? ' — ' + truck.description : '' %></option>
          <% }) %>
        </select>
      <% } %>
      <div class="load-rate-qty-drive-row">
        <div class="field-num-compact">
          <label for="review_rate">Load Rate ($)</label>
          <input type="number" step="0.01" min="0" max="9999.99" inputmode="decimal" placeholder="0000.00" name="rate" id="review_rate" class="input-num-4dec" data-four-dec="1" value="<%= load.rate != null && load.rate !== '' ? Number(load.rate).toFixed(2) : '' %>">
        </div>
        <div class="field-num-compact">
          <label for="review_qty">Wet Ton/Qty</label>
          <input type="number" step="0.01" min="0" max="9999.99" inputmode="decimal" placeholder="0000.00" name="weight_quantity" id="review_qty" class="input-num-4dec" data-four-dec="1" value="<%= load.weight_quantity != null ? load.weight_quantity : '' %>">
        </div>
      </div>
      <div class="load-self-row">
        <div class="self-load-group">
          <label class="self-check-label" for="has_self_load">
            <input type="checkbox" name="has_self_load" id="has_self_load" value="1" <%= load.has_self_load ? 'checked' : '' %>>
            <span>Self Load ($)</span>
          </label>
          <div id="review_self_wrap" class="self-amount-inline" style="<%= load.has_self_load ? 'display:inline-flex;' : 'display:none;' %>">
            <input type="number" step="0.01" min="0" max="9999.99" inputmode="decimal" placeholder="20.00" name="self_load_amount" id="review_self_amount" class="input-num-4dec" data-four-dec="1" value="<%= load.self_load_amount != null && Number(load.self_load_amount) > 0 ? Number(load.self_load_amount).toFixed(2) : '20.00' %>">
          </div>
        </div>
        <div class="self-load-group drive-time-group">
          <label class="self-check-label" for="has_drive_time">
            <input type="checkbox" name="has_drive_time" id="has_drive_time" value="1" <%= load.has_drive_time ? 'checked' : '' %>>
            <span>Drive Time ($)</span>
          </label>
          <div id="review_drive_wrap" class="self-amount-inline" style="<%= load.has_drive_time ? 'display:inline-flex;' : 'display:none;' %>">
            <input type="number" step="0.01" min="0" max="9999.99" inputmode="decimal" placeholder="0000.00" name="drive_time_amount" id="review_drive_amount" class="input-num-4dec" data-four-dec="1" value="<%= load.has_drive_time && load.drive_time_amount != null ? Number(load.drive_time_amount).toFixed(2) : '0.00' %>">
          </div>
        </div>
        <div class="self-load-group fuel-surcharge-group">
          <label class="self-check-label" for="has_fuel_surcharge">
            <input type="checkbox" name="has_fuel_surcharge" id="has_fuel_surcharge" value="1" data-fsc-rates="<%= JSON.stringify(typeof fuelRates !== 'undefined' ? fuelRates : []) %>" <%= load.has_fuel_surcharge ? 'checked' : '' %>>
            <span>Fuel Surcharge</span>
          </label>
          <input type="hidden" name="fuel_surcharge_amount" id="review_fuel_amount" value="<%= Number(load.has_fuel_surcharge) ? money(loadFuelSurcharge(load, typeof fuelRates !== 'undefined' ? fuelRates : []).total) : '0.00' %>">
        </div>
      </div>
      <div class="load-totals-row">
        <div class="load-total-under" id="review_load_total">Load Total: $<%= money(loadTotalAmount(load)) %></div>
        <div class="load-total-under fuel-total-under" id="review_fuel_total" title="Uses the fuel rate for the Load Date's week: Load Rate × FSC % × Wet Tons"><% const fscNow = loadFuelSurcharge(load, typeof fuelRates !== 'undefined' ? fuelRates : []); %><%= !Number(load.has_fuel_surcharge) ? 'Fuel Surcharge Total: $0.00' : (fscNow.pending ? 'Fuel Surcharge Total: Rate pending ($0.00)' : 'Fuel Surcharge Total: $' + money(fscNow.total) + ' @ ' + Number(fscNow.percent).toFixed(2) + '%') %></div>
      </div>
      <label for="driver_pay_type">Driver Pay Basis / Type</label>
      <select name="driver_pay_type" id="driver_pay_type">
        <option value="percentage" <%= load.driver_pay_type === 'flat' ? '' : 'selected' %>>Percentage of Load (% — uses Driver's Profile Pay %)</option>
        <option value="flat" <%= load.driver_pay_type === 'flat' ? 'selected' : '' %>>Flat / Daily Rate ($ for this load/day)</option>
      </select>
      <div id="flat_rate_wrap">
        <label for="driver_flat_rate">Driver Flat / Daily Rate ($)</label>
        <input type="number" step="0.01" min="0" max="9999.99" inputmode="decimal" name="driver_flat_rate" id="driver_flat_rate" class="input-num-4dec" value="<%= load.driver_flat_rate != null && load.driver_flat_rate !== '' ? load.driver_flat_rate : '0.00' %>">
      </div>
      <p class="muted" id="pay_basis_help"></p>
      <% if (drivers && drivers.length) { %>
        <label>Assign Driver</label>
        <select name="driver_id">
          <option value="">-- Select Driver --</option>
          <% drivers.forEach(function (driver) { %>
            <option value="<%= driver.id %>" <%= String(load.driver_id) === String(driver.id) ? 'selected' : '' %>><%= driver.name %><%= driver.status === 'inactive' ? ' (Inactive)' : '' %></option>
          <% }) %>
        </select>
      <% } %>
      <% if (tickets.length) { %>
        <label>Remove uploaded ticket/BOL</label>
        <% tickets.forEach(function (ticket) { %>
          <div class="check">
            <input type="checkbox" name="remove_tickets" value="<%= ticket.id %>" id="remove-<%= ticket.id %>">
            <label for="remove-<%= ticket.id %>">Remove <%= ticket.original_name || 'file' %></label>
          </div>
        <% }) %>
      <% } %>
      <label>Add ticket/BOL files</label>
      <input type="file" name="tickets" accept="image/*,application/pdf,.pdf,.doc,.docx,.xls,.xlsx" multiple>
      <button type="submit" name="action" value="save">Save Changes</button>
    </form>
  </div>

  <% if (user.role === 'admin') { %>
    <form class="card" method="POST" action="/loads/<%= load.id %>/missing-info">
      <h2>Missing Info Flag</h2>
      <p class="muted">This note stays on the admin dashboard until it is cleared.</p>
      <label>Completeness note</label>
      <textarea name="missing_info_note" rows="3"><%= load.missing_info_note || '' %></textarea>
      <button type="submit">Save Missing Info Flag</button>
    </form>
  <% } %>

  <div class="review-actions">
    <% if (load.status === 'submitted') { %>
      <form method="POST" action="/loads/<%= load.id %>/approve">
        <button class="approve" type="submit">Approve</button>
      </form>
    <% } %>
    <% if (load.status === 'submitted' || load.status === 'approved') { %>
      <form method="POST" action="/loads/<%= load.id %>/reject" onsubmit="return confirm('Send this load back to the driver as a draft?');">
        <label>Rejection reason</label>
        <textarea name="rejection_reason" rows="3" placeholder="Tell the driver what to fix"></textarea>
        <button class="danger" type="submit">Reject to Draft</button>
      </form>
    <% } %>
    <form method="POST" action="/loads/<%= load.id %>/delete" onsubmit="return confirm('Delete this load? This cannot be undone.');">
      <button class="danger" type="submit">Delete Load</button>
    </form>
  </div>
<% } else if (load.status === 'draft') { %>
  <p><a class="btn" href="/loads/<%= load.id %>/edit">Edit Draft</a></p>
<% } %>
<p><a href="/loads">Back to Loads</a></p>
<script src="/js/fuel-surcharge.js"></script>
<script>
  const payType = document.getElementById('driver_pay_type');
  const flatWrap = document.getElementById('flat_rate_wrap');
  const payHelp = document.getElementById('pay_basis_help');
  const reviewRate = document.getElementById('review_rate');
  const reviewQty = document.getElementById('review_qty');
  const reviewDriveCheck = document.getElementById('has_drive_time');
  const reviewDriveWrap = document.getElementById('review_drive_wrap');
  const reviewDriveAmount = document.getElementById('review_drive_amount');
  const reviewSelfCheck = document.getElementById('has_self_load');
  const reviewSelfWrap = document.getElementById('review_self_wrap');
  const reviewSelfAmount = document.getElementById('review_self_amount');
  const reviewFlatRate = document.getElementById('driver_flat_rate');
  const reviewLoadTotal = document.getElementById('review_load_total');
  const reviewFuelCheck = document.getElementById('has_fuel_surcharge');
  const reviewFuelAmount = document.getElementById('review_fuel_amount');
  const reviewFuelTotal = document.getElementById('review_fuel_total');
  const fscRates = reviewFuelCheck ? (function () { try { return JSON.parse(reviewFuelCheck.getAttribute('data-fsc-rates') || '[]'); } catch (e) { return []; } })() : [];
  const fscDateInput = document.querySelector('input[name="load_date"]');
  const reviewProjectSelect = document.getElementById('review_project_select');

  function syncReviewFuelAmount() {
    if (!reviewFuelCheck) return;
    if (!reviewFuelCheck.checked) {
      if (reviewFuelAmount) reviewFuelAmount.value = '0.00';
      if (reviewFuelTotal) reviewFuelTotal.textContent = 'Fuel Surcharge Total: $0.00';
      return;
    }
    const qty = Number(reviewQty && reviewQty.value);
    const rate = Number(reviewRate && reviewRate.value);
    const isFlat = payType && payType.value === 'flat';
    // Surcharge/Ton = Load Rate x FSC decimal; Total = Surcharge/Ton x Wet Tons (flat loads: Flat Amount x FSC decimal)
    const fsc = window.DT1Fuel.loadFuelSurchargeForDate({
      history: fscRates,
      loadDate: fscDateInput ? fscDateInput.value : '',
      rate: Number.isFinite(rate) ? rate : 0,
      tons: Number.isFinite(qty) ? qty : 0,
      isFlat,
      flatAmount: Number(reviewFlatRate && reviewFlatRate.value) || 0
    });
    const calc = fsc.total.toFixed(2);
    if (reviewFuelAmount) reviewFuelAmount.value = calc;
    if (reviewFuelTotal) {
      reviewFuelTotal.textContent = fsc.pending
        ? 'Fuel Surcharge Total: Rate pending ($0.00)'
        : 'Fuel Surcharge Total: $' + calc + ' @ ' + fsc.percent.toFixed(2) + '%';
      reviewFuelTotal.title = fsc.pending
        ? 'No fuel rate posted yet for this Load Date\'s week; $0.00 until it is posted.'
        : 'Week rate $' + fsc.dieselRate.toFixed(3) + ' effective ' + fsc.effectiveDate + ': Load Rate × ' + fsc.decimal + ' × Wet Tons';
    }
    return;
  }

  function syncReviewLoadTotal() {
    if (!reviewLoadTotal) return;
    const qty = Number(reviewQty && reviewQty.value);
    const rate = Number(reviewRate && reviewRate.value);
    const isFlat = payType && payType.value === 'flat';
    const baseHaul = (Number.isFinite(qty) ? qty : 0) * (Number.isFinite(rate) ? rate : 0);
    const base = (isFlat && baseHaul === 0)
      ? (Number.isFinite(Number(reviewFlatRate && reviewFlatRate.value)) ? Number(reviewFlatRate.value) : 0)
      : baseHaul;
    const drive = (reviewDriveCheck && reviewDriveCheck.checked)
      ? (Number.isFinite(Number(reviewDriveAmount && reviewDriveAmount.value)) ? Number(reviewDriveAmount.value) : 0)
      : 0;
    const self = (reviewSelfCheck && reviewSelfCheck.checked)
      ? (Number.isFinite(Number(reviewSelfAmount && reviewSelfAmount.value)) ? Number(reviewSelfAmount.value) : 0)
      : 0;
    reviewLoadTotal.textContent = 'Load Total: $' + (base + drive + self).toFixed(2);
    syncReviewFuelAmount();
  }

  function syncReviewDriveWrap() {
    if (reviewDriveWrap && reviewDriveCheck) {
      reviewDriveWrap.style.display = reviewDriveCheck.checked ? 'inline-flex' : 'none';
    }
  }

  function syncReviewSelfWrap() {
    if (reviewSelfWrap && reviewSelfCheck) {
      if (reviewSelfCheck.checked && reviewSelfAmount && (!reviewSelfAmount.value || Number(reviewSelfAmount.value) === 0)) {
        reviewSelfAmount.value = '20.00';
      }
      reviewSelfWrap.style.display = reviewSelfCheck.checked ? 'inline-flex' : 'none';
    }
  }

  if (reviewDriveCheck) {
    reviewDriveCheck.addEventListener('change', () => {
      if (reviewDriveCheck.checked) {
        const opt = reviewProjectSelect && reviewProjectSelect.options ? reviewProjectSelect.options[reviewProjectSelect.selectedIndex] : null;
        if (reviewDriveAmount && (!reviewDriveAmount.value || Number(reviewDriveAmount.value) === 0)) {
          reviewDriveAmount.value = (Number(opt ? opt.getAttribute('data-drivetime-amount') : 0) || 0).toFixed(2);
        }
      } else if (reviewDriveAmount) {
        reviewDriveAmount.value = '0.00';
      }
      syncReviewDriveWrap();
      syncReviewLoadTotal();
    });
  }
  if (reviewDriveAmount && reviewDriveCheck) {
    reviewDriveAmount.addEventListener('input', () => {
      if (Number(reviewDriveAmount.value) > 0 && !reviewDriveCheck.checked) {
        reviewDriveCheck.checked = true;
      }
    });
  }
  if (fscDateInput) {
    fscDateInput.addEventListener('change', syncReviewFuelAmount);
    fscDateInput.addEventListener('input', syncReviewFuelAmount);
  }
  if (reviewFuelCheck) {
    reviewFuelCheck.addEventListener('change', () => {
      syncReviewFuelAmount();
      syncReviewLoadTotal();
    });
  }
  if (reviewProjectSelect) {
    reviewProjectSelect.addEventListener('change', () => {
      const opt = reviewProjectSelect.options[reviewProjectSelect.selectedIndex];
      if (!opt || !opt.value) return;
      if (reviewRate) reviewRate.value = (Number(opt.getAttribute('data-rate')) || 0).toFixed(2);
      if (reviewFuelCheck) reviewFuelCheck.checked = opt.getAttribute('data-fsc') === '1';
      const hasDrive = opt.getAttribute('data-drivetime') === '1';
      if (reviewDriveCheck) reviewDriveCheck.checked = hasDrive;
      if (reviewDriveAmount) reviewDriveAmount.value = hasDrive ? (Number(opt.getAttribute('data-drivetime-amount')) || 0).toFixed(2) : '0.00';
      syncReviewDriveWrap();
      syncReviewLoadTotal();
    });
  }
  if (reviewSelfCheck) {
    reviewSelfCheck.addEventListener('change', () => {
      if (reviewSelfCheck.checked) {
        if (reviewSelfAmount && (!reviewSelfAmount.value || Number(reviewSelfAmount.value) === 0)) {
          reviewSelfAmount.value = '20.00';
        }
      } else if (reviewSelfAmount) {
        reviewSelfAmount.value = '0.00';
      }
      syncReviewSelfWrap();
      syncReviewLoadTotal();
    });
  }
  [reviewRate, reviewQty, reviewDriveAmount, reviewSelfAmount, reviewFlatRate].forEach((el) => {
    if (el) {
      el.addEventListener('input', syncReviewLoadTotal);
      el.addEventListener('change', syncReviewLoadTotal);
    }
  });

  function syncPayType() {
    if (!payType || !flatWrap) return;
    const flat = payType.value === 'flat';
    flatWrap.style.display = flat ? 'block' : 'none';
    if (payHelp) {
      payHelp.textContent = flat
        ? 'Driver Pay = Driver Flat / Daily Rate + Drive Time + Self Load. Fuel surcharge is not included.'
        : 'Driver Pay = (Qty/Wet Ton × Rate × Driver Pay %) + Drive Time + Self Load. Fuel surcharge is not included.';
    }
    syncReviewLoadTotal();
  }
  if (payType) {
    payType.addEventListener('change', syncPayType);
    syncPayType();
  }
  syncReviewDriveWrap();
  syncReviewSelfWrap();
  syncReviewLoadTotal();
</script>
<%- include('partials/close') %>
