<%- include('partials/open', { title: driver.name || 'Driver', user: user, active: 'drivers', headerTitle: driver.name || 'Driver', backHref: '/drivers' }) %>
<h1><%= driver.name %></h1>
<% if (typeof saved !== 'undefined' && saved) { %><div class="all-clear">Driver saved.</div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>

<div class="card profile-header-card" id="profile-header">
  <img class="profile-pic profile-pic-lg" src="<%= driver.profile_pic || '/default-avatar.svg' %>" alt="">
  <div>
    <div><strong>Name:</strong> <%= driver.first_name || '' %> <%= driver.middle_initial || '' %> <%= driver.last_name || '' %></div>
    <div><strong>Address:</strong> <%= driver.address || '—' %></div>
    <div><strong>City:</strong> <%= driver.city || '—' %></div>
    <div><strong>State:</strong> <%= driver.state || '—' %></div>
    <div><strong>Zip:</strong> <%= driver.zip || '—' %></div>
    <div><strong>Phone:</strong> <%= driver.phone || '—' %></div>
    <div><strong>Email:</strong> <%= driver.email %></div>
    <div><strong>Hire Date:</strong> <%= driver.hire_date || '—' %></div>
    <div><strong>DOB:</strong> <%= driver.dob || '—' %></div>
    <div><strong>Pay %:</strong> <%= driver.pay_percentage || 'Not set' %></div>
    <div><strong>Status:</strong> <%= (driver.status || 'active') === 'inactive' ? 'Inactive' : 'Active' %></div>
    <p class="header-actions"><a class="btn" href="#reset-password">Reset Password</a></p>
  </div>
</div>
<form method="POST" action="/drivers/<%= driver.id %>/status">
  <input type="hidden" name="return_to" value="profile">
  <input type="hidden" name="status" value="<%= (driver.status || 'active') === 'inactive' ? 'active' : 'inactive' %>">
  <button type="submit"><%= (driver.status || 'active') === 'inactive' ? 'Activate' : 'Deactivate' %></button>
</form>

<div class="card" id="reset-password">
  <h2>Reset Password</h2>
  <% if (typeof resetNotice !== 'undefined' && resetNotice) { %>
    <p><%= resetNotice.mustChange ? 'Temporary password. The driver must choose a new password on the next sign-in.' : 'Password updated. The driver can sign in with this password.' %></p>
    <div class="temp" id="temp-password"><%= resetNotice.password %></div>
  <% } %>
  <% if (typeof passwordSent !== 'undefined' && passwordSent) { %>
    <p>Email: <strong><%= passwordSent.emailStatus %></strong></p>
    <p>Text: <strong><%= passwordSent.smsStatus %></strong></p>
  <% } %>
  <% if (typeof shareLinks !== 'undefined' && shareLinks) { %>
    <p class="welcome-actions">
      <a class="btn btn-secondary" href="<%= shareLinks.mailto %>">Open Email</a>
      <a class="btn btn-secondary" href="<%= shareLinks.smsHref %>">Open Text Message</a>
    </p>
  <% } %>
  <% if (typeof resetRequest !== 'undefined' && resetRequest && !(typeof resetNotice !== 'undefined' && resetNotice)) { %>
    <div class="error">This driver requested a password reset. Email could not be sent. Generate a temporary password and share it with them.</div>
  <% } %>

  <h3>Generate Temporary Password &amp; Force Reset on Next Login</h3>
  <form method="POST" action="/drivers/<%= driver.id %>/reset-password">
    <input type="hidden" name="mode" value="temp">
    <label for="temp_password">Custom temporary password (optional)</label>
    <input id="temp_password" type="text" name="temp_password" autocomplete="off" minlength="6" placeholder="Leave blank to generate one">
    <button type="submit">Generate Temporary Password</button>
  </form>

  <% if (driver.must_change_password && driver.temp_password) { %>
    <form class="welcome-actions" method="POST" action="/drivers/<%= driver.id %>/send-password">
      <button type="submit" name="channel" value="both">Email &amp; Text Password</button>
      <button type="submit" class="btn-draft" name="channel" value="email">Email Password</button>
      <button type="submit" class="btn-draft" name="channel" value="sms">Text Password</button>
    </form>
  <% } %>

  <h3>Set New Password Directly</h3>
  <form method="POST" action="/drivers/<%= driver.id %>/reset-password">
    <input type="hidden" name="mode" value="set">
    <label for="new_password">New Password</label>
    <input id="new_password" type="text" name="new_password" required minlength="6" autocomplete="off">
    <label class="check-line" for="must_change">
      <input id="must_change" type="checkbox" name="must_change" value="1">
      Driver must change this password on next sign-in
    </label>
    <button type="submit">Set Password</button>
  </form>
</div>

<h2>Status</h2>
<p class="muted">Green, yellow, and red levels for this driver.</p>
<%- include('partials/levels', { levels: levels, linked: false }) %>

<div class="card">
  <h2>Edit Driver</h2>
  <p class="muted">Email is the driver's login. Only an admin can change it.</p>
  <form method="POST" action="/drivers/<%= driver.id %>">
    <label>First Name</label>
    <input type="text" name="first_name" value="<%= driver.first_name || '' %>" required>
    <label>Middle Initial</label>
    <input type="text" name="middle_initial" maxlength="1" value="<%= driver.middle_initial || '' %>">
    <label>Last Name</label>
    <input type="text" name="last_name" value="<%= driver.last_name || '' %>" required>
    <label>Email Address (Username)</label>
    <input type="email" name="email" value="<%= driver.email || '' %>" required>
    <label>Phone Number</label>
    <input type="tel" name="phone" value="<%= driver.phone || '' %>">
    <label>Address</label>
    <input type="text" name="address" value="<%= driver.address || '' %>" placeholder="Street address">
    <label>City</label>
    <input type="text" name="city" value="<%= driver.city || '' %>">
    <label>State</label>
    <input type="text" name="state" value="<%= driver.state || '' %>" maxlength="32">
    <label>Zip</label>
    <input type="text" name="zip" value="<%= driver.zip || '' %>" inputmode="numeric">
    <label>Hire Date</label>
    <input type="date" name="hire_date" value="<%= driver.hire_date || '' %>">
    <label>Date of Birth</label>
    <input type="date" name="dob" value="<%= driver.dob || '' %>">
    <label>Driver Percentage Pay (%)</label>
    <input type="number" step="0.01" name="pay_percentage" value="<%= driver.pay_percentage != null ? driver.pay_percentage : '' %>">
    <label>Status</label>
    <select name="status">
      <option value="active" <%= (driver.status || 'active') !== 'inactive' ? 'selected' : '' %>>Active</option>
      <option value="inactive" <%= driver.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
    </select>
    <button type="submit">Save Driver</button>
  </form>
</div>

<div class="card">
  <h2>CDL License</h2>
  <% const cdl = docs.find(d => d.doc_type === 'cdl'); %>
  <% if (cdl) { %>
    <span class="badge <%= getStatusClass(cdl.expiration_date) %>"><%= getStatusText(cdl.expiration_date) %></span>
    <p>Expires: <%= cdl.expiration_date %></p>
  <% } else { %>
    <p><span class="badge red">Missing</span> No CDL uploaded</p>
  <% } %>
  <form method="POST" action="/drivers/<%= driver.id %>/upload" enctype="multipart/form-data">
    <input type="hidden" name="doc_type" value="cdl">
    <label>File</label>
    <input type="file" name="file" accept="image/*,.pdf" required>
    <label>Expiration Date</label>
    <input type="date" name="expiration_date" required>
    <button type="submit">Upload CDL</button>
  </form>
</div>

<div class="card">
  <h2>Medical Card</h2>
  <% const med = docs.find(d => d.doc_type === 'medical_card'); %>
  <% if (med) { %>
    <span class="badge <%= getStatusClass(med.expiration_date) %>"><%= getStatusText(med.expiration_date) %></span>
    <p>Expires: <%= med.expiration_date %></p>
  <% } else { %>
    <p><span class="badge red">Missing</span> No Medical Card uploaded</p>
  <% } %>
  <form method="POST" action="/drivers/<%= driver.id %>/upload" enctype="multipart/form-data">
    <input type="hidden" name="doc_type" value="medical_card">
    <label>File</label>
    <input type="file" name="file" accept="image/*,.pdf" required>
    <label>Expiration Date</label>
    <input type="date" name="expiration_date" required>
    <button type="submit">Upload Medical Card</button>
  </form>
</div>
<div class="card">
  <h2>Welcome Email &amp; Text</h2>
  <p><a class="btn btn-secondary" href="/communications?driver_id=<%= driver.id %>">Message Driver</a></p>
  <p class="muted">Send this driver their login and the steps to save the DT1 Logistics app on their phone. If their temporary password is no longer on file, a new one is created.</p>
  <form class="welcome-actions" method="POST" action="/drivers/<%= driver.id %>/send-welcome">
    <button type="submit" name="channel" value="both">Send Welcome Email &amp; Text</button>
    <button type="submit" class="btn-draft" name="channel" value="email">Send Email</button>
    <button type="submit" class="btn-draft" name="channel" value="sms">Send Text (SMS)</button>
  </form>
</div>
<p><a href="/drivers">Back to Drivers</a></p>
<%- include('partials/close') %>
