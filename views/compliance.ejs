<%- include('partials/open', { title: 'Compliance', user: user, active: 'compliance' }) %>
<h1>Compliance</h1>
<p class="muted">Set an expiration date for each item. Missing dates, expired dates, and dates within 14 days show red on Home. Dates within 60 days show yellow.</p>
<p class="muted">Color coding: <span class="badge green">Green (Active)</span> · <span class="badge yellow">Yellow (≤60 days)</span> · <span class="badge red">Red (missing, ≤14 days, or expired)</span></p>

<% if (!items.length) { %>
  <p>No compliance items yet.</p>
<% } %>
<% items.forEach(function (item) { %>
  <div class="card">
    <div class="counts">
      <strong><%= item.name %></strong>
      <span class="badge <%= getStatusClass(item.expiration_date) %>"><%= getStatusText(item.expiration_date) %></span>
    </div>
    <form class="stack-form" method="POST" action="/compliance/<%= item.id %>">
      <label>Name</label>
      <input type="text" name="name" value="<%= item.name %>" required>
      <label>Expiration Date</label>
      <input type="date" name="expiration_date" value="<%= item.expiration_date || '' %>">
      <label>Notes</label>
      <textarea name="notes" rows="2"><%= item.notes || '' %></textarea>
      <button type="submit">Save</button>
    </form>
  </div>
<% }) %>

<h2>Add Compliance Item</h2>
<form class="stack-form form-narrow" method="POST" action="/compliance">
  <label>Name</label>
  <input type="text" name="name" placeholder="e.g. Insurance" required>
  <label>Expiration Date</label>
  <input type="date" name="expiration_date">
  <label>Notes</label>
  <textarea name="notes" rows="2"></textarea>
  <button type="submit">Add Item</button>
</form>
<%- include('partials/close') %>
