<%- include('partials/open', { title: `Fuel`, user: user, active: 'fuel' }) %>
<h1>Fuel</h1>
<div class="rate-box current">
      <strong>Current Weekly Fuel Rate</strong>
      <% if (current) { %>
        <p style="font-size:22px;margin:8px 0;">$<%= Number(current.central_atlantic_rate || 0).toFixed(3) %></p>
        <p>Effective: <%= current.effective_date %> · Surcharge: <%= Number(current.surcharge_percent || 0).toFixed(2) %>%</p>
        <p style="font-size:13px;color:#666;">Central Atlantic (PADD 1B) · Updated Tuesdays from EIA</p>
      <% } else { %>
        <p>No rate set yet.</p>
      <% } %>
    </div>

    <div class="rate-box">
      <strong>Rate History</strong>
      <div class="history">
        <% if (rates && rates.length) { %>
          <% rates.forEach(r => { %>
            <div class="history-item">
              <%= r.effective_date %> — $<%= Number(r.central_atlantic_rate || 0).toFixed(3) %> (<%= Number(r.surcharge_percent || 0).toFixed(2) %>%)
            </div>
          <% }) %>
        <% } else { %>
          <p>No history yet.</p>
        <% } %>
      </div>
    </div>

    <p>Fuel surcharges are calculated at the load level but are not shown to drivers and are not included in driver pay.</p>
    <a href="/receipts/new" style="display:inline-block;background:#1B365D;color:white;padding:10px 16px;border-radius:8px;text-decoration:none;">Upload Fuel Receipt</a>
<%- include('partials/close') %>
