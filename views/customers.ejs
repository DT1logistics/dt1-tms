<%- include('partials/open', { title: `Customers &amp; Projects`, user: user, active: 'customers' }) %>
<h1>Customers &amp; Projects</h1>
<a href="/customers/new" class="btn">+ Add Customer</a>
    <a href="/projects" class="btn">All Projects</a>
    <% if (!customers.length) { %>
      <p>No customers yet.</p>
    <% } else { %>
      <% customers.forEach(customer => { %>
        <% const projects = projectsByCustomer[customer.id] || []; %>
        <div class="card">
          <div><a href="/customers/<%= customer.id %>"><strong><%= customer.name %></strong></a> <span class="muted">(<%= customer.status || 'active' %>)</span></div>
          <div class="muted">Point of Contact: <%= customer.poc_name || '—' %></div>
          <div class="muted">Phone: <%= customer.poc_phone || '—' %> · Email: <%= customer.poc_email || '—' %></div>
          <div class="muted">Billing: <%= customer.address_line1 || '—' %><% if (customer.address_line2) { %>, <%= customer.address_line2 %><% } %></div>
          <div class="muted">Terms: <%= customer.terms || 'Net 30' %></div>
          <div style="margin-top:8px;"><strong><%= projects.length %></strong> project<%= projects.length === 1 ? '' : 's' %></div>
          <% if (projects.length) { %>
            <ul class="projects">
              <% projects.forEach(project => { %>
                <li><%= project.display_name %> — $<%= money(project.default_rate) %></li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      <% }) %>
    <% } %>
<%- include('partials/close') %>
