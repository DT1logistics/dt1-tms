<details class="settlement-loads">
  <summary>View <%= loads.length %> Load<%= loads.length === 1 ? '' : 's' %> in Settlement</summary>
  <div class="settlement-load-list">
    <% loads.forEach(function (load) { %>
      <div class="settlement-load">
        <div><strong><%= formatLoadDate(load.load_date) || '—' %></strong> · Ticket <%= load.ticket_number || '—' %> · <span class="status <%= load.status %>"><%= loadStatusLabel(load.status, load.settlement_status) %></span></div>
        <div><%= load.project_display || 'Unassigned' %><% if (load.customer_name) { %> · <%= load.customer_name %><% } %></div>
        <div>Qty/Wet Ton <%= load.weight_quantity != null ? load.weight_quantity : '—' %> · <%= load.payInfo.basis %> · Driver Pay $<%= money(load.payInfo.pay) %><% if (Number(load.detention) === 1) { %> · Detention $<%= money(load.payInfo.detention) %><% } %></div>
      </div>
    <% }) %>
  </div>
</details>
