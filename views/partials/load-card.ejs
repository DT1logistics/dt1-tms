<div class="load-card">
  <div>
    <strong><%= load.ticket_number || 'No Ticket' %></strong>
    <span class="status <%= load.status %>"><%= loadStatusLabel(load.status, load.settlement_status) %></span>
    <% const origin = loadOriginLabel(load); %>
    <% if (origin) { %><span class="origin-badge"><%= origin %></span><% } %>
    <% if (user.role === 'admin' && load.review_status === 'flagged_missing_info') { %>
      <span class="status flagged">Flagged — missing info</span>
    <% } %>
    <% if (user.role === 'admin' && load.review_decision === 'rejected') { %>
      <span class="status rejected">Rejected</span>
    <% } else if (user.role === 'admin' && load.review_decision === 'accepted') { %>
      <span class="status cleared">Accepted</span>
    <% } %>
  </div>
  <% if (load.status === 'approved' && load.settlement_status !== 'approved' && load.load_date) { %>
    <div class="muted"><%= settlementWeekLabel(load.load_date) %></div>
  <% } %>
  <% if (load.status === 'draft' && load.rejection_reason) { %>
    <div class="reject-note"><strong>Rejected — needs a fix:</strong> <%= load.rejection_reason %></div>
  <% } %>
  <% if (user.role === 'admin' && load.review_status === 'flagged_missing_info') { %>
    <div class="reject-note"><strong>Flagged — missing info:</strong> <%= load.review_notes || load.missing_info_note || 'Needs review' %></div>
  <% } %>
  <% if (user.role === 'admin' && load.review_decision === 'rejected' && load.review_decision_reason) { %>
    <div class="reject-note"><strong>Rejected:</strong> <%= load.review_decision_reason %></div>
  <% } %>
  <div>Date: <%= formatLoadDate(load.load_date) || '—' %></div>
  <div>Project: <%= load.project_display || '—' %></div>
  <div>Trucks: <%= loadTruckLabel(load) || '—' %></div>
  <div>Origin: <%= load.origin || '—' %></div>
  <div>Destination: <%= load.destination || load.description || '—' %></div>
  <% if (load.notes || load.admin_notes) { %>
    <div class="load-notes-card"><strong>Notes:</strong> <span class="load-notes-text"><%= load.notes || load.admin_notes %></span></div>
  <% } %>
  <div>Qty/Wet Ton: <%= load.weight_quantity != null ? load.weight_quantity : '—' %></div>
  <div>Rate: <%= usd(load.rate) %></div>
  <% if (user.role === 'admin' && load.payInfo) { %>
    <%# Item 2: admins see Driver Pay first, then the Total Load Pay that will be invoiced, at every status. %>
    <div class="pay-line admin-driver-pay">Driver Pay: <%= usd(load.payInfo.pay) %></div>
    <div class="muted"><%= load.payInfo.basis %> · Drive Time <%= usd(load.payInfo.drive) %> · Self Load <%= usd(load.payInfo.self) %> · Detention <%= usd(load.payInfo.detention) %>. <% if (load.payInfo.flat) { %>Drive Time, Self Load, and Detention are added in full.<% } else { %>Drive Time is the driver's pay percentage of the drive-time fee. Self Load and Detention are added in full.<% } %></div>
    <div class="total-load-pay-line">Total Load Pay (invoiced): <%= usd(loadTotalFor(user, load)) %><% if (hasTotalLoadPay(load)) { %> <span class="muted">(project flat rate)</span><% } %></div>
    <div>Fuel Surcharge: <%= hasTotalLoadPay(load) ? 'Not added (Total Load Pay)' : (Number(load.has_fuel_surcharge) === 1 ? 'Yes' : 'No') %></div>
  <% } else { %>
  <div>Load Total: <%= usd(loadTotalFor(user, load)) %></div>
  <% } %>
  <% if (load.showPay && user.role !== 'admin') { %>
    <div class="pay-line">Driver Pay: <%= usd(load.payInfo.pay) %></div>
    <div class="muted"><%= load.payInfo.basis %> · Drive Time <%= usd(load.payInfo.drive) %> · Self Load <%= usd(load.payInfo.self) %> · Detention <%= usd(load.payInfo.detention) %>. <% if (load.payInfo.flat) { %>Drive Time, Self Load, and Detention are added in full.<% } else { %>Drive Time is the driver's pay percentage of the drive-time fee. Self Load and Detention are added in full.<% } %></div>
  <% } %>
  <div>Load Ticket/BOL:
    <% if (load.tickets && load.tickets.length) { %>
      <ul class="ticket-names">
        <% load.tickets.forEach(function (ticket) { %>
          <li>
            <%= ticket.original_name || 'Ticket' %>
            <a href="/loads/<%= load.id %>/files/<%= ticket.id %>" target="_blank" rel="noopener">View</a>
            <a href="/loads/<%= load.id %>/files/<%= ticket.id %>?download=1">Download</a>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      None
    <% } %>
  </div>
  <% if (Number(load.has_drive_time) === 1) { %>
    <div>Drive Time: <%= usd(load.drive_time_amount) %></div>
  <% } %>
  <% if (Number(load.has_self_load) === 1) { %>
    <div>Self Load: <%= usd(load.self_load_amount) %></div>
  <% } %>
  <% if (Number(load.detention) === 1) { %>
    <div>Detention: <%= usd(load.detention_amount) %></div>
  <% } %>
  <% if (user.role === 'admin') { %><div class="muted">Driver: <%= load.driver_name || 'Unassigned' %></div><% } %>
  <p>
    <a href="/loads/<%= load.id %>">Review</a>
    <% if (load.status === 'draft' && (user.role === 'admin' || String(load.driver_id) === String(user.id))) { %>
      · <a href="/loads/<%= load.id %>/edit">Continue draft</a>
    <% } %>
  </p>
</div>
