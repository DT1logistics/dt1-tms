<div class="load-card">
  <div>
    <strong><%= load.ticket_number || 'No Ticket' %></strong>
    <span class="status <%= load.status %>"><%= loadStatusLabel(load.status, load.settlement_status) %></span>
    <% const origin = loadOriginLabel(load); %>
    <% if (origin) { %><span class="origin-badge"><%= origin %></span><% } %>
  </div>
  <% if (load.status === 'approved' && load.settlement_status !== 'approved') { %>
    <div class="muted">Pending Driver Settlement Approval<%= load.load_date ? ' · ' + settlementWeekLabel(load.load_date) : '' %></div>
  <% } %>
  <% if (load.status === 'draft' && load.rejection_reason) { %>
    <div class="reject-note"><strong>Rejected — needs a fix:</strong> <%= load.rejection_reason %></div>
  <% } %>
  <div>Date: <%= load.load_date || '—' %></div>
  <div>Project: <%= load.project_display || '—' %></div>
  <% if (load.origin || load.destination) { %>
    <div>Origin: <%= load.origin || '—' %> · Destination: <%= load.destination || '—' %></div>
  <% } %>
  <div>Description: <%= load.description || '—' %></div>
  <div>Qty/Wet Ton: <%= load.weight_quantity != null ? load.weight_quantity : '—' %></div>
  <div>Rate: $<%= money(load.rate) %></div>
  <div>Load Total: $<%= money((Number(load.weight_quantity) || 0) * (Number(load.rate) || 0)) %></div>
  <% if (user.role === 'admin') { %>
    <div>Fuel Surcharge: <%= Number(load.has_fuel_surcharge) === 1 ? 'Yes' : 'No' %></div>
  <% } %>
  <% if (load.payInfo && user.role === 'admin') { %>
    <div class="muted"><%= load.payInfo.basis %></div>
  <% } %>
  <% if (load.showPay) { %>
    <div class="pay-line">Driver Pay: $<%= money(load.payInfo.pay) %></div>
    <div class="muted"><%= load.payInfo.basis %> · Drive Time $<%= money(load.payInfo.drive) %> · Self Load $<%= money(load.payInfo.self) %></div>
  <% } %>
  <div>Load Ticket/BOL:
    <% if (load.tickets && load.tickets.length) { %>
      <ul class="ticket-names">
        <% load.tickets.forEach(function (ticket) { %>
          <li>
            <%= ticket.original_name || 'Ticket' %>
            <a href="/loads/<%= load.id %>/files/<%= ticket.id %>" target="_blank" rel="noopener">View</a>
            <a href="/loads/<%= load.id %>/files/<%= ticket.id %>?download=1">Download</a>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      None
    <% } %>
  </div>
  <% if (Number(load.has_drive_time) === 1) { %>
    <div>Drive Time: $<%= money(load.drive_time_amount) %></div>
  <% } %>
  <% if (Number(load.has_self_load) === 1) { %>
    <div>Self Load: $<%= money(load.self_load_amount) %></div>
  <% } %>
  <% if (user.role === 'admin') { %><div class="muted">Driver: <%= load.driver_name || 'Unassigned' %></div><% } %>
  <p>
    <a href="/loads/<%= load.id %>">Review</a>
    <% if (load.status === 'draft' && (user.role === 'admin' || String(load.driver_id) === String(user.id))) { %>
      · <a href="/loads/<%= load.id %>/edit">Continue draft</a>
    <% } %>
  </p>
</div>
