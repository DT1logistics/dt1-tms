<%- include('partials/open', { title: 'Fuel Rate (Central Atlantic)', user: user, active: 'fuel-rate' }) %>
<h1>Fuel Rate (Central Atlantic)</h1>
<% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
<% if (latest) { %>
  <div class="card">
    <p><strong>Effective:</strong> <%= latest.effective_date %></p>
    <p><strong>Current Rate:</strong> $<%= Number(latest.central_atlantic_rate || 0).toFixed(3) %></p>
    <p><strong>Base:</strong> $4.00</p>
    <p><strong>Surcharge %:</strong> <%= Number(latest.surcharge_percent || 0).toFixed(2) %>%</p>
    <p style="font-size:13px;color:#666;">
      Fuel Surcharge % = (Weekly Diesel Rate − $4.00) ÷ 10 → ($<%= Number(latest.central_atlantic_rate || 0).toFixed(3) %> − $4.00) ÷ 10 = <%= (Number(latest.surcharge_percent || 0) / 100).toFixed(4) %> (<%= Number(latest.surcharge_percent || 0).toFixed(2) %>%).<br>
      Surcharge/Ton = Load Rate × Surcharge % · Total Fuel Surcharge = Surcharge/Ton × Wet Tons (flat-rate loads: Flat Amount × Surcharge %).<br>
      Example: $6.485 diesel → 24.85%; $12.65/ton × 0.2485 = $3.143525/ton × 24.16 wet tons = $75.95.
      Each load uses the rate for its own week: the latest row here effective on or before the Load Date (Rate pending until that week is posted).<br>
      Fuel surcharge is billed as its own invoice line and is not part of Load Total or Driver Pay.
    </p>
    <p><strong>Updated by:</strong> <%= latest.updated_by || 'Not recorded' %><% if (latest.updated_at) { %> on <%= auditStamp(latest.updated_at) %><% } %></p>
    <p style="font-size:13px;color:#666;">Updated every Tuesday from EIA Central Atlantic (PADD 1B).</p>
  </div>
<% } else { %>
  <p>No fuel rate set yet.</p>
<% } %>
<form method="POST" action="/fuel-rate">
  <label>Effective Date</label>
  <input type="date" name="effective_date" required>
  <label>Central Atlantic Diesel Rate ($)</label>
  <input type="number" step="0.001" name="central_atlantic_rate" placeholder="e.g. 6.508" required>
  <button type="submit">Save / Update Rate</button>
</form>
<% if (history && history.length) { %>
  <h2>Rate history</h2>
  <div class="card">
    <% history.forEach(function (row) { %>
      <div>
        <%= row.effective_date || '—' %> — $<%= Number(row.central_atlantic_rate || 0).toFixed(3) %>
        (<%= Number(row.surcharge_percent || 0).toFixed(2) %>%)
        · Updated by: <%= row.updated_by || 'Not recorded' %><% if (row.updated_at) { %> on <%= auditStamp(row.updated_at) %><% } %>
      </div>
    <% }) %>
  </div>
<% } %>
<p style="margin-top:12px;font-size:13px;">Source: <a href="https://www.eia.gov/petroleum/gasdiesel/" target="_blank">EIA Gasoline and Diesel Fuel Update</a></p>
<%- include('partials/close') %>
