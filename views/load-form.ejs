<%- include('partials/open', { title: load && load.id ? 'Edit Load' : 'New Load', user: user, active: load && load.id ? 'loads' : 'new-load', headerTitle: load && load.id ? 'Edit Load' : 'New Load', backHref: '/loads' }) %>
<h1><%= load && load.id ? 'Edit Load' : 'New Load' %></h1>
<% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
<% if (load && load.status === 'draft' && load.rejection_reason) { %>
  <div class="reject-note"><strong>This load was sent back as a draft.</strong> <%= load.rejection_reason %></div>
<% } %>
<% if (!projects || !projects.length) { %>
  <p>No active projects yet. An admin needs to add a customer and project before a load can be entered.</p>
<% } %>
<form method="POST" action="<%= load && load.id ? '/loads/' + load.id : '/loads' %>" enctype="multipart/form-data" id="loadForm">
  <% const adminModes = user.role === 'admin' && (!load.id || !load.status || load.status === 'draft'); %>
  <% if (adminModes) { %>
    <fieldset class="mode-picker">
      <legend>How should this load be saved?</legend>
      <label class="mode-option">
        <input type="radio" name="admin_mode" value="assign" <%= load.entry_mode === 'entered' ? '' : 'checked' %>>
        <span>
          <strong>Assign to Driver (Saves to Driver's Drafts)</strong>
          <span>The driver finishes Ticket #, Qty/Wet Ton, and the Load Ticket/BOL, then submits the load.</span>
        </span>
      </label>
      <label class="mode-option">
        <input type="radio" name="admin_mode" value="enter" <%= load.entry_mode === 'entered' ? 'checked' : '' %>>
        <span>
          <strong>Enter &amp; Submit Load for Driver</strong>
          <span>Enter the completed load, including Ticket #, Qty/Wet Ton, and the Load Ticket/BOL, then submit or approve it.</span>
        </span>
      </label>
      <div class="assign-sms-box" id="assign_sms_box">
        <label class="check">
          <input type="checkbox" name="send_assign_sms" id="send_assign_sms" value="1" checked>
          <span><strong>Send text message (SMS) notification to driver:</strong> &ldquo;DT1 Logistics has assigned you a new Load&rdquo;</span>
        </label>
        <label class="check">
          <input type="checkbox" name="send_assign_email" id="send_assign_email" value="1" checked>
          <span>Also send email copy to driver&rsquo;s email address</span>
        </label>
        <label for="assign_sms_preview" class="assign-sms-label">Text Message (SMS) Preview <span class="muted">(auto-updates with load details; editable before assigning)</span></label>
        <textarea name="assign_sms_message" id="assign_sms_preview" rows="3" class="sms-preview-input">DT1 Logistics has assigned you a new Load. Open the DT1 TMS app to review, complete, and submit your load ticket: https://dt1-tms.onrender.com/loads</textarea>
      </div>
    </fieldset>
  <% } %>
  <div class="load-date-ticket-row">
    <div class="field-date-compact">
      <label for="load_date">Load Date</label>
      <input type="date" name="load_date" id="load_date" class="input-date-compact" max="9999-12-31" value="<%= load.load_date || '' %>">
    </div>
    <div class="field-ticket-flex">
      <label for="ticket_number">Ticket Number</label>
      <input type="text" name="ticket_number" id="ticket_number" value="<%= load.ticket_number || '' %>" placeholder="Ticket #">
    </div>
  </div>
  <label>Project</label>
  <select name="project_id" id="project_select">
    <option value="">-- Select Project --</option>
    <% (projects || []).forEach(project => { %>
      <option value="<%= project.id %>"
        data-rate="<%= project.default_rate %>"
        data-fsc="<%= project.has_fuel_surcharge ? 1 : 0 %>"
        data-drivetime="<%= project.has_drive_time ? 1 : 0 %>"
        data-drivetime-amount="<%= project.default_drive_time_amount %>"
        data-pay-type="<%= project.default_driver_pay_type === 'flat' ? 'flat' : 'percentage' %>"
        data-flat-rate="<%= project.default_driver_flat_rate || 0 %>"
        <%= String(load.project_id) === String(project.id) ? 'selected' : '' %>>
        <%= project.display_name %>
      </option>
    <% }) %>
  </select>
  <label for="destination">Destination</label>
  <input type="text" name="destination" id="destination" value="<%= load.destination || load.description || '' %>" placeholder="Delivery location / jobsite destination">
  <% if (user.role === 'admin') { %>
    <label for="admin_notes">Notes <span class="admin-only-badge">Admin Only — Not visible to driver</span></label>
    <textarea name="admin_notes" id="admin_notes" rows="3" placeholder="Internal admin notes for this load (visible to Admin only)"><%= load.admin_notes || load.notes || '' %></textarea>
  <% } %>
  <% if (trucks && trucks.length) { %>
    <label>Truck</label>
    <select name="truck_id">
      <option value="">-- No truck --</option>
      <% trucks.forEach(function (truck) { %>
        <option value="<%= truck.id %>" <%= String(load.truck_id) === String(truck.id) ? 'selected' : '' %>><%= truck.number %><%= truck.description ? ' — ' + truck.description : '' %></option>
      <% }) %>
    </select>
  <% } %>
  <div class="load-rate-qty-drive-row">
    <div class="field-num-compact">
      <label for="load_rate">Load Rate ($)</label>
      <input type="number" step="0.01" min="0" max="9999.99" inputmode="decimal" placeholder="0000.00" name="rate" id="load_rate" class="input-num-4dec" data-four-dec="1" value="<%= load.rate != null && load.rate !== '' ? Number(load.rate).toFixed(2) : '' %>" <%= user.role === 'admin' ? '' : 'readonly' %>>
    </div>
    <div class="field-num-compact">
      <label for="weight_quantity">Wet Ton/Qty</label>
      <input type="number" step="0.01" min="0" max="9999.99" inputmode="decimal" placeholder="0000.00" name="weight_quantity" id="weight_quantity" class="input-num-4dec" data-four-dec="1" value="<%= load.weight_quantity != null && load.weight_quantity !== '' ? load.weight_quantity : '' %>">
    </div>
  </div>
  <div class="load-self-row">
    <div class="self-load-group">
      <label class="self-check-label" for="has_self_load">
        <input type="checkbox" name="has_self_load" id="has_self_load" value="1" <%= load.has_self_load ? 'checked' : '' %>>
        <span>Self Load ($)</span>
      </label>
      <div id="self_load_wrap" class="self-amount-inline" style="<%= load.has_self_load ? 'display:inline-flex;' : 'display:none;' %>">
        <input type="number" step="0.01" min="0" max="9999.99" inputmode="decimal" placeholder="20.00" name="self_load_amount" id="self_load_amount" class="input-num-4dec" data-four-dec="1" value="<%= load.self_load_amount != null && Number(load.self_load_amount) > 0 ? Number(load.self_load_amount).toFixed(2) : '20.00' %>">
      </div>
    </div>
    <div class="self-load-group drive-time-group">
      <label class="self-check-label" for="has_drive_time">
        <input type="checkbox" name="has_drive_time" id="has_drive_time" value="1" <%= load.has_drive_time ? 'checked' : '' %>>
        <span>Drive Time ($)</span>
      </label>
      <div id="drive_time_wrap" class="self-amount-inline" style="<%= load.has_drive_time ? 'display:inline-flex;' : 'display:none;' %>">
        <input type="number" step="0.01" min="0" max="9999.99" inputmode="decimal" placeholder="0000.00" name="drive_time_amount" id="drive_time_amount" class="input-num-4dec" data-four-dec="1" value="<%= load.has_drive_time && load.drive_time_amount != null && load.drive_time_amount !== '' ? Number(load.drive_time_amount).toFixed(2) : '0.00' %>">
      </div>
    </div>
    <% if (user.role === 'admin') { %>
    <div class="self-load-group fuel-surcharge-group">
      <label class="self-check-label" for="has_fuel_surcharge">
        <input type="checkbox" name="has_fuel_surcharge" id="has_fuel_surcharge" value="1" data-fsc-percent="<%= typeof surchargePercent !== 'undefined' ? surchargePercent : 0 %>" <%= load.has_fuel_surcharge ? 'checked' : '' %>>
        <span>Fuel Surcharge</span>
      </label>
      <input type="hidden" name="fuel_surcharge_amount" id="fuel_surcharge_amount" value="<%= Number(load.has_fuel_surcharge) ? (((Number(load.weight_quantity) || 0) * (Number(load.rate) || 0)) * ((Number(typeof surchargePercent !== 'undefined' ? surchargePercent : 0)) / 100)).toFixed(2) : '0.00' %>">
    </div>
    <% } %>
  </div>
  <div class="load-totals-row">
    <div class="load-total-under" id="load_total">Load Total: $0.00</div>
    <% if (user.role === 'admin') { %>
    <div class="load-total-under fuel-total-under" id="fuel_surcharge_total" title="Calculated at <%= Number(typeof surchargePercent !== 'undefined' ? surchargePercent : 0).toFixed(2) %>% EIA Fuel Surcharge">Fuel Surcharge Total: $<%= Number(load.has_fuel_surcharge) ? (((Number(load.weight_quantity) || 0) * (Number(load.rate) || 0)) * ((Number(typeof surchargePercent !== 'undefined' ? surchargePercent : 0)) / 100)).toFixed(2) : '0.00' %></div>
    <% } %>
  </div>
  <% if (user.role !== 'admin') { %><p class="muted compact-hint">Rate comes from the project. An admin can change it.</p><% } %>
  <% if (user.role === 'admin') { %>
    <label for="driver_pay_type">Driver Pay Basis / Type</label>
    <select name="driver_pay_type" id="driver_pay_type">
      <option value="percentage" <%= load.driver_pay_type === 'flat' ? '' : 'selected' %>>Percentage of Load (% — uses Driver's Profile Pay %)</option>
      <option value="flat" <%= load.driver_pay_type === 'flat' ? 'selected' : '' %>>Flat / Daily Rate ($ for this load/day)</option>
    </select>
    <div id="flat_rate_wrap" style="<%= load.driver_pay_type === 'flat' ? '' : 'display:none;' %>">
      <label for="driver_flat_rate">Driver Flat / Daily Rate ($)</label>
      <input type="number" step="0.01" min="0" max="9999.99" inputmode="decimal" name="driver_flat_rate" id="driver_flat_rate" class="input-num-4dec" data-four-dec="1" value="<%= load.driver_flat_rate != null && load.driver_flat_rate !== '' ? load.driver_flat_rate : '0.00' %>">
    </div>
    <p class="muted" id="pay_basis_help">Driver Pay = (Qty/Wet Ton × Rate × Driver Pay %) + Drive Time + Self Load. Fuel surcharge is not included.</p>
  <% } %>
  <% if (user.role === 'admin' && drivers && drivers.length) { %>
    <label>Driver</label>
    <select name="driver_id">
      <option value="">-- Select Driver --</option>
      <% drivers.forEach(d => { %>
        <option value="<%= d.id %>" <%= String(load.driver_id) === String(d.id) ? 'selected' : '' %>><%= d.name %><%= d.status === 'inactive' ? ' (Inactive)' : '' %></option>
      <% }) %>
    </select>
  <% } %>
  <div class="ticket-block">
    <label>Load Ticket/BOL</label>
    <% if (tickets && tickets.length) { %>
      <p class="muted">Already attached</p>
      <ul class="ticket-names">
        <% tickets.forEach(function (ticket) { %>
          <li>
            <% if (ticket.id && load.id) { %>
              <a href="/loads/<%= load.id %>/files/<%= ticket.id %>" target="_blank" rel="noopener"><%= ticket.original_name %></a>
              <a href="/loads/<%= load.id %>/files/<%= ticket.id %>?download=1">Download</a>
            <% } else { %>
              <%= ticket.original_name %>
            <% } %>
            <% if (ticket.id) { %>
              <label class="check"><input type="checkbox" name="remove_tickets" value="<%= ticket.id %>"> Remove</label>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
    <p class="muted">Upload a file, choose a photo, or take a photo.</p>
    <label class="ticket-btn">
      Upload
      <input id="ticket-upload" type="file" name="tickets" accept="image/*,application/pdf,.pdf,.doc,.docx,.xls,.xlsx" multiple>
    </label>
    <ul id="ticket-names" class="ticket-names"></ul>
  </div>
  <div class="load-actions">
    <a class="btn btn-secondary" href="/loads">Cancel</a>
    <% if (user.role === 'admin' && load && load.id && load.status && load.status !== 'draft') { %>
      <button type="submit" name="action" value="save">Save Changes</button>
    <% } else if (user.role === 'admin') { %>
      <button type="submit" name="action" value="draft" class="btn-draft" data-admin-mode="assign">Assign Load to Driver (Draft)</button>
      <button type="submit" name="action" value="submit" data-admin-mode="enter">Submit Load for Driver</button>
      <button type="submit" name="action" value="approve" data-admin-mode="enter">Submit &amp; Approve Load</button>
    <% } else { %>
      <button type="submit" name="action" value="draft" class="btn-draft">Save as Draft</button>
      <button type="submit" name="action" value="submit">Submit Load</button>
    <% } %>
  </div>
</form>
<script>
  const projectSelect = document.getElementById('project_select');
  const rateInput = document.querySelector('input[name="rate"]');
  const isAdminForm = <%= user.role === 'admin' ? 'true' : 'false' %>;
  const fscInput = document.querySelector('input[name="has_fuel_surcharge"]');
  const fscAmount = document.getElementById('fuel_surcharge_amount');
  const fscTotal = document.getElementById('fuel_surcharge_total');
  const fscPercent = fscInput ? (Number(fscInput.getAttribute('data-fsc-percent')) || 0) : 0;
  const driveInput = document.querySelector('input[name="has_drive_time"]');
  const driveAmount = document.querySelector('input[name="drive_time_amount"]');
  const driveWrap = document.getElementById('drive_time_wrap');
  const selfInput = document.querySelector('input[name="has_self_load"]');
  const selfAmount = document.querySelector('input[name="self_load_amount"]');
  const selfWrap = document.getElementById('self_load_wrap');

  function money(value) {
    const n = Number(value);
    return (Number.isFinite(n) ? n : 0).toFixed(2);
  }

  function syncDriveWrap() {
    driveWrap.style.display = driveInput.checked ? 'inline-flex' : 'none';
  }

  function syncFuelAmount() {
    if (!fscInput) return;
    if (!fscInput.checked) {
      if (fscAmount) fscAmount.value = '0.00';
      if (fscTotal) fscTotal.textContent = 'Fuel Surcharge Total: $0.00';
      return;
    }
    const qty = Number(qtyInput && qtyInput.value);
    const rate = Number(rateInput && rateInput.value);
    const payTypeEl = document.getElementById('driver_pay_type');
    const flatRateEl = document.getElementById('driver_flat_rate');
    const isFlat = payTypeEl && payTypeEl.value === 'flat';
    const baseHaul = (Number.isFinite(qty) ? qty : 0) * (Number.isFinite(rate) ? rate : 0);
    const base = (isFlat && baseHaul === 0)
      ? (Number.isFinite(Number(flatRateEl && flatRateEl.value)) ? Number(flatRateEl.value) : 0)
      : baseHaul;
    const calc = money(base * (fscPercent / 100));
    if (fscAmount) fscAmount.value = calc;
    if (fscTotal) fscTotal.textContent = 'Fuel Surcharge Total: $' + calc;
  }

  function syncSelfWrap() {
    if (selfInput.checked && (!selfAmount.value || Number(selfAmount.value) === 0)) {
      selfAmount.value = '20.00';
    }
    selfWrap.style.display = selfInput.checked ? 'inline-flex' : 'none';
  }

  function applyProject() {
    const opt = projectSelect.options[projectSelect.selectedIndex];
    if (!opt || !opt.value) return;
    rateInput.value = money(opt.getAttribute('data-rate'));
    if (fscInput) fscInput.checked = opt.getAttribute('data-fsc') === '1';
    const payType = document.getElementById('driver_pay_type');
    const flatAmount = document.getElementById('driver_flat_rate');
    if (payType) {
      payType.value = opt.getAttribute('data-pay-type') === 'flat' ? 'flat' : 'percentage';
      if (flatAmount) flatAmount.value = money(opt.getAttribute('data-flat-rate'));
      syncPayType();
    }
    const hasDrive = opt.getAttribute('data-drivetime') === '1';
    driveInput.checked = hasDrive;
    driveAmount.value = hasDrive ? money(opt.getAttribute('data-drivetime-amount')) : '0.00';
    syncDriveWrap();
    syncLoadTotal();
  }

  const qtyInput = document.getElementById('weight_quantity');
  const loadTotal = document.getElementById('load_total');
  function syncLoadTotal() {
    const qty = Number(qtyInput && qtyInput.value);
    const rate = Number(rateInput && rateInput.value);
    const payTypeEl = document.getElementById('driver_pay_type');
    const flatRateEl = document.getElementById('driver_flat_rate');
    const isFlat = payTypeEl && payTypeEl.value === 'flat';
    const baseHaul = (Number.isFinite(qty) ? qty : 0) * (Number.isFinite(rate) ? rate : 0);
    const base = (isFlat && baseHaul === 0)
      ? (Number.isFinite(Number(flatRateEl && flatRateEl.value)) ? Number(flatRateEl.value) : 0)
      : baseHaul;
    const drive = (driveInput && driveInput.checked)
      ? (Number.isFinite(Number(driveAmount && driveAmount.value)) ? Number(driveAmount.value) : 0)
      : 0;
    const self = (selfInput && selfInput.checked)
      ? (Number.isFinite(Number(selfAmount && selfAmount.value)) ? Number(selfAmount.value) : 0)
      : 0;
    const total = base + drive + self;
    loadTotal.textContent = 'Load Total: $' + total.toFixed(2);
    syncFuelAmount();
  }

  projectSelect.addEventListener('change', applyProject);
  function clampFourDigitDecimal(el) {
    const raw = String(el.value || '');
    if (!raw) return;
    const parts = raw.split('.');
    let intPart = parts[0].replace(/[^0-9]/g, '');
    let changed = false;
    if (intPart.length > 4) {
      intPart = intPart.slice(0, 4);
      changed = true;
    }
    let decPart = parts.length > 1 ? parts[1].replace(/[^0-9]/g, '') : null;
    if (decPart !== null && decPart.length > 2) {
      decPart = decPart.slice(0, 2);
      changed = true;
    }
    if (changed) {
      el.value = decPart !== null ? (intPart + '.' + decPart) : intPart;
    }
  }
  document.querySelectorAll('[data-four-dec="1"]').forEach((el) => {
    el.addEventListener('input', () => clampFourDigitDecimal(el));
  });
  qtyInput.addEventListener('input', syncLoadTotal);
  qtyInput.addEventListener('change', syncLoadTotal);
  rateInput.addEventListener('input', syncLoadTotal);
  rateInput.addEventListener('change', syncLoadTotal);
  driveAmount.addEventListener('input', () => {
    if (Number(driveAmount.value) > 0 && !driveInput.checked) {
      driveInput.checked = true;
      syncDriveWrap();
    }
    syncLoadTotal();
  });
  driveAmount.addEventListener('change', syncLoadTotal);
  if (fscInput) {
    fscInput.addEventListener('change', () => {
      syncFuelAmount();
      syncLoadTotal();
    });
  }
  selfAmount.addEventListener('input', syncLoadTotal);
  selfAmount.addEventListener('change', syncLoadTotal);

  driveInput.addEventListener('change', () => {
    if (driveInput.checked) {
      const opt = projectSelect.options[projectSelect.selectedIndex];
      if (!driveAmount.value || Number(driveAmount.value) === 0) {
        driveAmount.value = money(opt ? opt.getAttribute('data-drivetime-amount') : 0);
      }
    } else {
      driveAmount.value = '0.00';
    }
    syncDriveWrap();
    syncLoadTotal();
  });

  selfInput.addEventListener('change', () => {
    if (selfInput.checked) {
      if (!selfAmount.value || Number(selfAmount.value) === 0) {
        selfAmount.value = '20.00';
      }
    } else {
      selfAmount.value = '0.00';
    }
    syncSelfWrap();
    syncLoadTotal();
  });

  const ticketInputs = document.querySelectorAll('input[name="tickets"]');
  const ticketNames = document.getElementById('ticket-names');
  function renderTicketNames() {
    ticketNames.replaceChildren();
    const names = [];
    ticketInputs.forEach((input) => {
      Array.from(input.files || []).forEach((file) => names.push(file.name));
    });
    if (!names.length) {
      const empty = document.createElement('li');
      empty.className = 'muted';
      empty.textContent = 'No ticket or BOL attached yet.';
      ticketNames.appendChild(empty);
      return;
    }
    names.forEach((name) => {
      const item = document.createElement('li');
      item.textContent = name;
      ticketNames.appendChild(item);
    });
  }
  ticketInputs.forEach((input) => input.addEventListener('change', renderTicketNames));
  renderTicketNames();

  syncDriveWrap();
  syncSelfWrap();
  syncLoadTotal();

  function syncPayType() {
    const payType = document.getElementById('driver_pay_type');
    const flatWrap = document.getElementById('flat_rate_wrap');
    const payHelp = document.getElementById('pay_basis_help');
    if (!payType || !flatWrap) return;
    const flat = payType.value === 'flat';
    flatWrap.style.display = flat ? 'block' : 'none';
    if (payHelp) {
      payHelp.textContent = flat
        ? 'Driver Pay = Driver Flat / Daily Rate + Drive Time + Self Load. Fuel surcharge is not included. Qty/Wet Ton can be left blank and defaults to 1.'
        : 'Driver Pay = (Qty/Wet Ton × Rate × Driver Pay %) + Drive Time + Self Load. Fuel surcharge is not included.';
    }
  }
  const payTypeInput = document.getElementById('driver_pay_type');
  const flatRateInput = document.getElementById('driver_flat_rate');
  if (payTypeInput) {
    payTypeInput.addEventListener('change', () => {
      syncPayType();
      syncLoadTotal();
    });
    syncPayType();
  }
  if (flatRateInput) {
    flatRateInput.addEventListener('input', syncLoadTotal);
    flatRateInput.addEventListener('change', syncLoadTotal);
  }

  const smsPreviewEl = document.getElementById('assign_sms_preview');
  let smsPreviewDirty = false;
  if (smsPreviewEl) {
    smsPreviewEl.addEventListener('input', () => { smsPreviewDirty = true; });
  }
  function buildAssignSmsPreview() {
    if (!smsPreviewEl || smsPreviewDirty) return;
    const dateInput = document.querySelector('input[name="load_date"]');
    const loadDate = dateInput && dateInput.value ? dateInput.value : '';
    const projOpt = projectSelect && projectSelect.options ? projectSelect.options[projectSelect.selectedIndex] : null;
    const projName = projOpt && projOpt.value ? projOpt.text.replace(/\s*\(\$[0-9.]+\)\s*$/, '').trim() : '';
    const truckSelect = document.querySelector('select[name="truck_id"]');
    const truckOpt = truckSelect && truckSelect.options ? truckSelect.options[truckSelect.selectedIndex] : null;
    const truckText = truckOpt && truckOpt.value ? ('Truck ' + truckOpt.text.split('—')[0].trim()) : '';
    const destInput = document.querySelector('input[name="destination"]');
    const dest = destInput && destInput.value ? destInput.value.trim() : '';
    const details = [];
    if (loadDate) details.push('for ' + loadDate);
    if (projName) details.push(projName);
    if (truckText) details.push(truckText);
    if (dest) details.push('Destination: ' + dest);
    const detailText = details.length ? (' (' + details.join(' — ') + ')') : '';
    smsPreviewEl.value = 'DT1 Logistics has assigned you a new Load' + detailText + '. Open the DT1 TMS app to review, complete, and submit your load ticket: https://dt1-tms.onrender.com/loads';
  }
  ['input[name="load_date"]', 'select[name="project_id"]', 'select[name="truck_id"]', 'input[name="destination"]'].forEach((sel) => {
    const el = document.querySelector(sel);
    if (el) {
      el.addEventListener('change', buildAssignSmsPreview);
      el.addEventListener('input', buildAssignSmsPreview);
    }
  });

  const modeRadios = document.querySelectorAll('input[name="admin_mode"]');
  function syncAdminMode() {
    const selected = document.querySelector('input[name="admin_mode"]:checked');
    const mode = selected ? selected.value : '';
    const smsBox = document.getElementById('assign_sms_box');
    if (smsBox) smsBox.hidden = mode !== 'assign';
    document.querySelectorAll('[data-admin-mode]').forEach((button) => {
      button.hidden = mode ? button.getAttribute('data-admin-mode') !== mode : false;
    });
    buildAssignSmsPreview();
  }
  modeRadios.forEach((radio) => radio.addEventListener('change', syncAdminMode));
  if (modeRadios.length) syncAdminMode();
</script>
<%- include('partials/close') %>
