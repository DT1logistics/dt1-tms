<%- include('partials/open', { title: `Add New Driver`, user: user, active: 'drivers' }) %>
<h1>Add New Driver</h1>
<% if (typeof error !== 'undefined') { %><div class="error"><%= error %></div><% } %>
    <form method="POST" action="/drivers">
      <label>Hire Date</label>
      <input type="date" name="hire_date" required>
      <label>First Name</label>
      <input type="text" name="first_name" required>
      <label>Middle Initial</label>
      <input type="text" name="middle_initial" maxlength="1">
      <label>Last Name</label>
      <input type="text" name="last_name" required>
      <label>Date of Birth</label>
      <input type="date" name="dob">
      <label>Address</label>
      <input type="text" name="address" placeholder="Street address">
      <label>City</label>
      <input type="text" name="city">
      <label>State</label>
      <input type="text" name="state" maxlength="32">
      <label>Zip</label>
      <input type="text" name="zip" inputmode="numeric">
      <label>Phone Number</label>
      <input type="tel" name="phone">
      <label>Email Address (Username)</label>
      <input type="email" name="email" required>
      <label>Driver Percentage Pay (%)</label>
      <input type="number" step="0.01" name="pay_percentage" placeholder="e.g. 25">
      <label class="check">
        <input type="checkbox" id="send_welcome_email" name="send_welcome_email" value="1">
        <span>Send Welcome Email</span>
      </label>
      <p class="muted">Save Profile sends nothing unless Send Welcome Email is checked. You can send the welcome email or text later from the driver&rsquo;s page.</p>
      <button type="submit">Save Profile</button>
    </form>
<%- include('partials/close') %>
